@page "/account/change-password"
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using Tessera.Core.Resources
@using Tessera.Data

@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["ChangePassword.PageTitle"]</PageTitle>

<div class="container">
    <h1>@Localizer["ChangePassword.PageTitle"]</h1>

    <StatusMessage />

    <div class="card" style="max-width: 32rem;">
        <p>@Localizer["ChangePassword.Heading"]</p>
        @if (!hasPassword)
        {
            <p class="text-soft">@Localizer["ChangePassword.NoPasswordIntro"]</p>
        }

        <form action="Account/ChangePassword" method="post" data-spinner-form>
            <AntiforgeryToken />
            @if (hasPassword)
            {
                <div class="form-floating mb-3">
                    <input type="password" class="form-control" id="currentPassword" name="currentPassword" placeholder=" " autocomplete="current-password" />
                    <label for="currentPassword">@Localizer["ChangePassword.CurrentPasswordLabel"]</label>
                </div>
            }
            <div class="form-floating mb-3">
                <input type="password" class="form-control" id="newPassword" name="newPassword" placeholder=" " autocomplete="new-password" required />
                <label for="newPassword">@Localizer["ChangePassword.NewPasswordLabel"]</label>
            </div>
            <div class="form-floating mb-3">
                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder=" " autocomplete="new-password" required />
                <label for="confirmPassword">@Localizer["ChangePassword.ConfirmNewPasswordLabel"]</label>
            </div>
            <button type="submit" class="btn btn-primary">
                @(hasPassword ? Localizer["ChangePassword.SubmitButton"] : Localizer["ChangePassword.SetSubmitButton"])
            </button>
        </form>
    </div>
</div>

@code {
    // Real HttpContext.User, not AuthenticationStateTask — this page is static SSR
    // ([ExcludeFromInteractiveRouting] via this folder's _Imports.razor), same reason
    // Login.razor reads HttpContext directly: no SignalR circuit ever exists here, so there's
    // no second render pass to lose a cookie-derived value to (see StatusMessage.razor — this
    // page redirects back to itself after the password change and needs that cookie read to
    // actually survive to display "Password changed.").
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private bool hasPassword;

    protected override async Task OnInitializedAsync()
    {
        var userId = Guid.Parse(HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier)!);
        var user = await UserManager.FindByIdAsync(userId.ToString());
        hasPassword = user is not null && await UserManager.HasPasswordAsync(user);
    }
}
