@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@using Tessera.Core.Abstractions
@using Tessera.Core.Resources
@using Tessera.Data
@using Tessera.Web.Services

@inject UserManager<ApplicationUser> UserManager
@inject UserProvisioningService UserProvisioning
@inject IServiceProvider ServiceProvider
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ForgotPassword> Logger
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["Account.ForgotPassword.PageTitle"]</PageTitle>

<h1>@Localizer["Account.ForgotPassword.PageTitle"]</h1>
<div class="row">
    <div class="col-lg-6">
        <section>
            <EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="forgot-password" data-spinner-form="true">
                <DataAnnotationsValidator />
                <p>@Localizer["Account.ForgotPassword.Heading"]</p>
                <hr />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="@Localizer["Account.EmailPlaceholder"]" />
                    <label for="Input.Email" class="form-label">@Localizer["Account.EmailLabel"]</label>
                    <ValidationMessage For="() => Input.Email" class="text-danger" />
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">@Localizer["Account.ForgotPassword.SubmitButton"]</button>
            </EditForm>
        </section>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    // Always lands on the confirmation page regardless of whether the email matched an
    // account, and only actually sends when it does — the alternative (a distinct
    // "no such account" message) lets an attacker enumerate registered emails.
    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is not null)
        {
            var emailSender = ServiceProvider.GetService<IEmailSender>();
            if (emailSender is not null)
            {
                var domainUser = await UserProvisioning.GetAsync(user.Id, CancellationToken.None);
                var culture = new CultureInfo(domainUser.PreferredCulture);
                CultureInfo.CurrentCulture = culture;
                CultureInfo.CurrentUICulture = culture;

                var code = await UserManager.GeneratePasswordResetTokenAsync(user);
                var encodedCode = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
                var resetLink = NavigationManager.GetUriWithQueryParameters(
                    NavigationManager.ToAbsoluteUri("Account/ResetPassword").ToString(),
                    new Dictionary<string, object?> { ["email"] = Input.Email, ["code"] = encodedCode });

                var subject = Localizer["Email.ResetPassword.Subject"].Value;
                var body = BuildResetPasswordEmailHtml(culture, resetLink);

                // Best-effort: a delivery failure (misconfigured role assignment, ACS outage)
                // must not surface as a 500 here — besides the obvious UX cost, throwing only
                // for accounts that exist would itself leak which emails are registered.
                try
                {
                    await emailSender.SendAsync(Input.Email, subject, body, CancellationToken.None);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to send password reset email.");
                }
            }
        }

        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    // Inline styles only, no external stylesheet, no CSS custom properties — mail clients
    // (Outlook desktop above all) don't reliably support either, so the design tokens from
    // docs/12-stile-sito.md are hand-copied as literal hex values here rather than referenced.
    // Table-based centering is deliberate for the same reason: the safest layout primitive
    // across mail clients, not a style preference.
    private string BuildResetPasswordEmailHtml(CultureInfo culture, string resetLink)
    {
        var encodedLink = System.Net.WebUtility.HtmlEncode(resetLink);
        var lang = culture.TwoLetterISOLanguageName;

        return $"""
            <!DOCTYPE html>
            <html lang="{lang}">
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <title>{Localizer["Email.ResetPassword.Subject"].Value}</title>
            </head>
            <body style="margin: 0; padding: 0; background-color: #ECEAE3; font-family: 'Inter', -apple-system, 'Segoe UI', Arial, sans-serif;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #ECEAE3;">
                    <tr>
                        <td align="center" style="padding: 32px 16px;">
                            <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="max-width: 480px; width: 100%; background-color: #F7F5EF; border: 1px solid #D7D3C6; border-radius: 14px;">
                                <tr>
                                    <td style="padding: 32px 32px 0 32px;">
                                        <span style="font-family: Georgia, 'Iowan Old Style', serif; font-size: 20px; font-weight: 600; color: #B5502E;">Tessera</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 20px 32px 0 32px; font-family: Georgia, 'Iowan Old Style', serif; font-size: 22px; font-weight: 600; color: #221E1C;">
                                        {Localizer["Email.ResetPassword.Heading"].Value}
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 12px 32px 0 32px; font-size: 15px; line-height: 1.6; color: #221E1C;">
                                        {Localizer["Email.ResetPassword.Body"].Value}
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 24px 32px 0 32px;">
                                        <a href="{encodedLink}" style="display: inline-block; background-color: #B5502E; color: #ffffff; text-decoration: none; font-size: 15px; font-weight: 600; padding: 12px 28px; border-radius: 8px;">
                                            {Localizer["Email.ResetPassword.ButtonText"].Value}
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 16px 32px 0 32px; font-size: 13px; line-height: 1.5; color: #6B665D;">
                                        {Localizer["Email.ResetPassword.ExpiryNote"].Value}
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 24px 32px 0 32px;">
                                        <div style="border-top: 1px solid #D7D3C6;"></div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 16px 32px 4px 32px; font-size: 13px; line-height: 1.5; color: #6B665D;">
                                        {Localizer["Email.ResetPassword.FallbackNote"].Value}
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 0 32px 24px 32px; font-size: 13px; line-height: 1.5; word-break: break-all;">
                                        <a href="{encodedLink}" style="color: #A24829;">{encodedLink}</a>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 0 32px 32px 32px; font-size: 13px; line-height: 1.5; color: #6B665D;">
                                        {Localizer["Email.ResetPassword.IgnoreNote"].Value}
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </body>
            </html>
            """;
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
