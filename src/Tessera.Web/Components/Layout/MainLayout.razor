@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using Tessera.Core.Resources
@using Tessera.Data

@inject IStringLocalizer<Messages> Localizer
@inject IDbContextFactory<TesseraDbContext> DbContextFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<div class="navbar" id="navbar-root" @onkeydown="HandleKeyDown">
    <a class="wordmark" href="/">Tessera</a>
    <button class="nav-toggle" type="button" @onclick="ToggleMenu" aria-label="@Localizer["Nav.ToggleMenu"]" aria-expanded="@(isMenuOpen ? "true" : "false")">
        <span></span><span></span><span></span>
    </button>
    <nav class="@(isMenuOpen ? "nav-open" : "")">
        <a href="/pricing">@Localizer["Nav.Pricing"]</a>
        <a href="/support">@Localizer["Nav.Support"]</a>
        <AuthorizeView>
            <Authorized>
                <a href="/spaces">@Localizer["Nav.YourSpaces"]</a>
                <a href="/chat">@Localizer["Nav.Chat"]</a>
                <a href="/settings">@Localizer["Nav.Settings"]</a>
                <a href="/account" class="nav-account">
                    <UserAvatar DisplayName="@displayName" PictureUrl="@pictureUrl" Size="1.75" />
                    @(displayName ?? Localizer["Nav.Account"].Value)
                </a>
                <form action="Account/Logout" method="post" style="margin: 0;">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="" />
                    <button type="submit" class="btn btn-secondary">@Localizer["Nav.LogOut"]</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a href="Account/Login">@Localizer["Nav.LogIn"]</a>
                <a href="Account/Register">@Localizer["Nav.Register"]</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@Body

<footer class="footer">
    <a href="/pricing">@Localizer["Nav.Pricing"]</a>
    <a href="/support">@Localizer["Nav.Support"]</a>
    <a href="/privacy">@Localizer["Nav.Privacy"]</a>
    <a href="/terms">@Localizer["Nav.Terms"]</a>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool isMenuOpen;
    private string? displayName;
    private string? pictureUrl;
    private DotNetObjectReference<MainLayout>? dotNetRef;

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;

    // Escape closes the menu whenever focus is anywhere inside the navbar — the toggle button
    // right after opening it, or a link inside the open <nav> itself (docs/13-piano-miglioramenti.md,
    // B6). Click-outside is handled separately, in JS (nav.js), since there's no pure-Blazor
    // way to detect a click landing outside this subtree.
    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && isMenuOpen)
        {
            isMenuOpen = false;
        }
    }

    // Invoked from nav.js when a click lands outside #navbar-root while the menu is open.
    [JSInvokable]
    public void CloseMenuFromOutsideClick()
    {
        isMenuOpen = false;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        // Fires on every in-app navigation, including a tap on a link inside this same open
        // menu — without this the menu stayed open over whatever page came next
        // (docs/13-piano-miglioramenti.md, B6).
        NavigationManager.LocationChanged += OnLocationChanged;

        if (AuthenticationStateTask is null)
        {
            return;
        }

        var authState = await AuthenticationStateTask;
        if (authState.User.FindFirstValue(ClaimTypes.NameIdentifier) is not { } rawUserId
            || !Guid.TryParse(rawUserId, out var userId))
        {
            return;
        }

        // A dedicated, short-lived context (see Program.cs) rather than a scoped/injected
        // service — the routed page under this layout is very likely running its own
        // OnInitializedAsync concurrently against the circuit's shared DbContext, and EF Core
        // throws if two operations touch the same context instance at once.
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var user = await db.DomainUsers.AsNoTracking().FirstOrDefaultAsync(x => x.Id == userId);
        displayName = user?.DisplayName;
        pictureUrl = user?.PictureUrl;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JsRuntime.InvokeVoidAsync("tesseraNav.init", dotNetRef, "navbar-root");
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!isMenuOpen)
        {
            return;
        }

        isMenuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        dotNetRef?.Dispose();
        // Fire-and-forget: the circuit may already be tearing down by the time this runs, and
        // the JS-side listener is scoped to a DOM node that's about to disappear regardless.
        _ = JsRuntime.InvokeVoidAsync("tesseraNav.dispose", "navbar-root");
    }
}
