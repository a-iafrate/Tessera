@page "/calendars"
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@using Tessera.Core.Abstractions
@using Tessera.Core.Calendars
@using Tessera.Core.Resources
@using Tessera.Core.Spaces
@using Tessera.Core.Users
@using Tessera.Data

@inject IServiceProvider ServiceProvider
@inject SpaceService SpaceService
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["Calendars.PageTitle"]</PageTitle>

<div class="container">
    <a href="/" class="text-soft">@Localizer["Common.BackToDashboard"]</a>
    <h1>@Localizer["Calendars.PageTitle"]</h1>

    @if (linkedAccounts is null)
    {
        <p class="text-soft">@Localizer["Calendars.NotConfigured"]</p>
    }
    else if (!loaded)
    {
        <p class="text-soft"><span class="spinner" aria-hidden="true"></span> @Localizer["Common.Loading"]</p>
    }
    else
    {
        @if (errorKey is not null)
        {
            <div class="alert alert-danger">@Localizer[$"Calendars.Error.{errorKey}", errorProviderName ?? ""]</div>
        }

        <div style="display: flex; gap: var(--space-4); flex-wrap: wrap;">
        @foreach (var state in providers)
        {
            <div class="card" style="flex: 1; min-width: 22rem;">
                <h2>@Localizer["Calendars.ProviderHeading", state.DisplayName]</h2>

                @if (!state.IsLinked)
                {
                    <p class="text-soft">@Localizer["Calendars.LinkIntro", state.DisplayName]</p>
                    <a class="btn btn-primary" href="/oauth/@state.RouteSegment/link">@Localizer["Calendars.LinkButton", state.DisplayName]</a>
                }
                else
                {
                    <p class="text-soft">@Localizer["Calendars.LinkedNote"]</p>

                    @if (state.Calendars.Count == 0)
                    {
                        <p class="text-soft">@Localizer["Calendars.Empty"]</p>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                            @foreach (var calendar in state.Calendars)
                            {
                                <div class="card">
                                    <div style="display: flex; align-items: center; gap: var(--space-3);">
                                        <label style="display: flex; align-items: center; gap: var(--space-2); flex: 1; cursor: pointer;">
                                            <input type="checkbox" checked="@calendar.IsEnabled" disabled="@isBusy"
                                                   @onchange="e => ToggleAsync(calendar.Id, (bool)e.Value!)" />
                                            <span>@calendar.Name</span>
                                            @if (calendar.IsPrimary)
                                            {
                                                <span class="badge badge-admin">@Localizer["Calendars.PrimaryBadge"]</span>
                                            }
                                        </label>
                                    </div>

                                    @if (calendar.IsEnabled && calendarSpace is not null)
                                    {
                                        <div style="margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--line);">
                                            <strong style="font-size: var(--text-sm);">@Localizer["Calendars.ShareHeading"]</strong>
                                            @if (mySpaces.Count == 0)
                                            {
                                                <p class="text-soft" style="margin: var(--space-1) 0 0;">@Localizer["Calendars.ShareNoSpaces"] <a href="/spaces">@Localizer["Calendars.ShareCreateSpaceLink"]</a></p>
                                            }
                                            else
                                            {
                                                <div style="display: flex; flex-direction: column; gap: var(--space-2); margin-top: var(--space-2);">
                                                    @foreach (var space in mySpaces)
                                                    {
                                                        var level = shareMappings.TryGetValue((space.Id, calendar.Id), out var mapping) ? mapping.ShareLevel : (CalendarShareLevel?)null;
                                                        var isDefaultWriteTarget = shareMappings.TryGetValue((space.Id, calendar.Id), out var m2) && m2.IsDefaultWriteTarget;
                                                        <div style="display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap;">
                                                            <span style="flex: 1; min-width: 8rem;">@space.Name</span>
                                                            <select disabled="@isBusy" style="padding: var(--space-2); border: 1px solid var(--line); border-radius: var(--radius-sm);"
                                                                    value="@LevelValue(level)" @onchange="e => SetShareLevelAsync(space.Id, calendar.Id, e.Value?.ToString())">
                                                                <option value="none">@Localizer["SpaceCalendars.LevelNone"]</option>
                                                                <option value="availability">@Localizer["SpaceCalendars.LevelAvailability"]</option>
                                                                <option value="details">@Localizer["SpaceCalendars.LevelDetails"]</option>
                                                                <option value="write">@Localizer["SpaceCalendars.LevelWrite"]</option>
                                                            </select>
                                                            @if (level == CalendarShareLevel.Write)
                                                            {
                                                                <label style="display: flex; align-items: center; gap: var(--space-2); cursor: pointer;">
                                                                    <input type="checkbox" checked="@isDefaultWriteTarget" disabled="@isBusy"
                                                                           @onchange="e => SetShareDefaultWriteTargetAsync(space.Id, calendar.Id, (bool)e.Value!)" />
                                                                    <span>@Localizer["SpaceCalendars.DefaultWriteTarget"]</span>
                                                                </label>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div style="display: flex; gap: var(--space-3); margin-top: var(--space-4);">
                        <a class="btn btn-secondary" href="/oauth/@state.RouteSegment/link">@Localizer["Calendars.RelinkButton", state.DisplayName]</a>
                        <button class="btn btn-danger" disabled="@isBusy" @onclick="() => UnlinkAsync(state.Provider)">
                            @if (isBusy) { <span class="spinner" aria-hidden="true"></span> }
                            @Localizer["Calendars.UnlinkButton", state.DisplayName]
                        </button>
                    </div>
                }
            </div>
        }
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    [SupplyParameterFromQuery]
    private string? Provider { get; set; }

    private LinkedAccountService? linkedAccounts;
    private CalendarSpaceService? calendarSpace;
    private Guid userId;
    private bool loaded;
    private bool isBusy;
    private string? errorKey;
    private string? errorProviderName;
    private List<ProviderState> providers = [];
    private List<Space> mySpaces = [];
    private Dictionary<(Guid SpaceId, Guid CalendarId), CalendarSpaceMapping> shareMappings = [];

    private sealed class ProviderState
    {
        public required ProviderKind Provider { get; init; }
        public required string DisplayName { get; init; }
        public required string RouteSegment { get; init; }
        public bool IsLinked { get; set; }
        public IReadOnlyList<ExternalCalendar> Calendars { get; set; } = [];
    }

    protected override async Task OnInitializedAsync()
    {
        // Only registered when Key Vault + at least one provider's credentials are configured
        // (Program.cs) — resolved via the service provider rather than @inject so a missing
        // registration renders a message instead of throwing.
        linkedAccounts = ServiceProvider.GetService<LinkedAccountService>();
        if (linkedAccounts is null)
        {
            return;
        }

        errorKey = Error switch
        {
            "denied" => "Denied",
            "state" => "State",
            "exchange" => "Exchange",
            _ => null,
        };
        errorProviderName = Provider switch
        {
            "google" => "Google",
            "microsoft" => "Microsoft",
            _ => null,
        };

        var authState = await AuthenticationStateTask!;
        userId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        // Only a provider with an actually-registered ICalendarProvider gets a card — one
        // provider's credentials being unconfigured shouldn't offer a link button that would
        // fail the moment someone clicks it (Program.cs only registers what's configured).
        var availableProviders = ServiceProvider.GetServices<ICalendarProvider>().Select(p => p.Provider).ToHashSet();
        foreach (var (provider, displayName) in new[] { (ProviderKind.Google, "Google"), (ProviderKind.Microsoft, "Microsoft") })
        {
            if (!availableProviders.Contains(provider))
            {
                continue;
            }

            var state = new ProviderState
            {
                Provider = provider,
                DisplayName = displayName,
                RouteSegment = provider.ToString().ToLowerInvariant(),
                IsLinked = await linkedAccounts.IsLinkedAsync(userId, provider, CancellationToken.None),
            };

            if (state.IsLinked)
            {
                state.Calendars = await linkedAccounts.GetCalendarsAsync(userId, provider, CancellationToken.None);
            }

            providers.Add(state);
        }

        // Only registered alongside the calendar feature itself (Program.cs) — resolved the
        // same optional way as linkedAccounts above.
        calendarSpace = ServiceProvider.GetService<CalendarSpaceService>();
        if (calendarSpace is not null)
        {
            mySpaces = (await SpaceService.GetForUserAsync(userId, CancellationToken.None)).ToList();
            await ReloadShareMappingsAsync();
        }

        loaded = true;
    }

    private async Task ReloadShareMappingsAsync()
    {
        if (calendarSpace is null)
        {
            return;
        }

        var enabledCalendarIds = providers.SelectMany(p => p.Calendars).Where(c => c.IsEnabled).Select(c => c.Id).ToList();
        if (enabledCalendarIds.Count == 0)
        {
            return;
        }

        foreach (var space in mySpaces)
        {
            var mappingsForSpace = await calendarSpace.GetMappingsAsync(space.Id, enabledCalendarIds, CancellationToken.None);
            foreach (var calendarId in enabledCalendarIds)
            {
                var key = (space.Id, calendarId);
                if (mappingsForSpace.TryGetValue(calendarId, out var mapping))
                {
                    shareMappings[key] = mapping;
                }
                else
                {
                    shareMappings.Remove(key);
                }
            }
        }
    }

    private static string LevelValue(CalendarShareLevel? level) => level switch
    {
        CalendarShareLevel.Availability => "availability",
        CalendarShareLevel.Details => "details",
        CalendarShareLevel.Write => "write",
        _ => "none",
    };

    private async Task SetShareLevelAsync(Guid spaceId, Guid externalCalendarId, string? value)
    {
        if (isBusy || calendarSpace is null)
        {
            return;
        }

        CalendarShareLevel? level = value switch
        {
            "availability" => CalendarShareLevel.Availability,
            "details" => CalendarShareLevel.Details,
            "write" => CalendarShareLevel.Write,
            _ => null,
        };

        isBusy = true;
        try
        {
            await calendarSpace.SetMappingAsync(userId, spaceId, externalCalendarId, level, isDefaultWriteTarget: false, CancellationToken.None);
            await ReloadShareMappingsAsync();
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SetShareDefaultWriteTargetAsync(Guid spaceId, Guid externalCalendarId, bool isDefaultWriteTarget)
    {
        if (isBusy || calendarSpace is null)
        {
            return;
        }

        isBusy = true;
        try
        {
            await calendarSpace.SetMappingAsync(userId, spaceId, externalCalendarId, CalendarShareLevel.Write, isDefaultWriteTarget, CancellationToken.None);
            await ReloadShareMappingsAsync();
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ToggleAsync(Guid externalCalendarId, bool enabled)
    {
        if (isBusy || linkedAccounts is null)
        {
            return;
        }

        isBusy = true;
        try
        {
            await linkedAccounts.SetCalendarEnabledAsync(userId, externalCalendarId, enabled, CancellationToken.None);
            foreach (var state in providers.Where(p => p.IsLinked))
            {
                state.Calendars = await linkedAccounts.GetCalendarsAsync(userId, state.Provider, CancellationToken.None);
            }
            await ReloadShareMappingsAsync();
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task UnlinkAsync(ProviderKind provider)
    {
        if (isBusy || linkedAccounts is null)
        {
            return;
        }

        var state = providers.First(p => p.Provider == provider);
        if (!await JsRuntime.InvokeAsync<bool>("confirm", Localizer["Calendars.UnlinkConfirm", state.DisplayName].Value))
        {
            return;
        }

        isBusy = true;
        StateHasChanged();
        try
        {
            await linkedAccounts.UnlinkAsync(provider, userId, CancellationToken.None);
            state.IsLinked = false;
            state.Calendars = [];
        }
        finally
        {
            isBusy = false;
        }
    }
}
