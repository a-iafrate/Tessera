@page "/calendars"
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@using Tessera.Core.Abstractions
@using Tessera.Core.Calendars
@using Tessera.Core.Resources
@using Tessera.Core.Users
@using Tessera.Data

@inject IServiceProvider ServiceProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["Calendars.PageTitle"]</PageTitle>

<div class="container">
    <a href="/" class="text-soft">@Localizer["Common.BackToDashboard"]</a>
    <h1>@Localizer["Calendars.PageTitle"]</h1>

    @if (linkedAccounts is null)
    {
        <p class="text-soft">@Localizer["Calendars.NotConfigured"]</p>
    }
    else if (!loaded)
    {
        <p class="text-soft"><span class="spinner" aria-hidden="true"></span> @Localizer["Common.Loading"]</p>
    }
    else
    {
        @if (errorKey is not null)
        {
            <div class="alert alert-danger">@Localizer[$"Calendars.Error.{errorKey}", errorProviderName ?? ""]</div>
        }

        @foreach (var state in providers)
        {
            <div class="card" style="max-width: 32rem;">
                <h2>@Localizer["Calendars.ProviderHeading", state.DisplayName]</h2>

                @if (!state.IsLinked)
                {
                    <p class="text-soft">@Localizer["Calendars.LinkIntro", state.DisplayName]</p>
                    <a class="btn btn-primary" href="/oauth/@state.RouteSegment/link">@Localizer["Calendars.LinkButton", state.DisplayName]</a>
                }
                else
                {
                    <p class="text-soft">@Localizer["Calendars.LinkedNote"]</p>

                    @if (state.Calendars.Count == 0)
                    {
                        <p class="text-soft">@Localizer["Calendars.Empty"]</p>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                            @foreach (var calendar in state.Calendars)
                            {
                                <div class="card" style="display: flex; align-items: center; gap: var(--space-3);">
                                    <label style="display: flex; align-items: center; gap: var(--space-2); flex: 1; cursor: pointer;">
                                        <input type="checkbox" checked="@calendar.IsEnabled" disabled="@isBusy"
                                               @onchange="e => ToggleAsync(calendar.Id, (bool)e.Value!)" />
                                        <span>@calendar.Name</span>
                                        @if (calendar.IsPrimary)
                                        {
                                            <span class="badge badge-admin">@Localizer["Calendars.PrimaryBadge"]</span>
                                        }
                                    </label>
                                </div>
                            }
                        </div>
                    }

                    <div style="display: flex; gap: var(--space-3); margin-top: var(--space-4);">
                        <a class="btn btn-secondary" href="/oauth/@state.RouteSegment/link">@Localizer["Calendars.RelinkButton", state.DisplayName]</a>
                        <button class="btn btn-danger" disabled="@isBusy" @onclick="() => UnlinkAsync(state.Provider)">
                            @if (isBusy) { <span class="spinner" aria-hidden="true"></span> }
                            @Localizer["Calendars.UnlinkButton", state.DisplayName]
                        </button>
                    </div>
                }
            </div>
        }

        @if (providers.Any(p => p.IsLinked && p.Calendars.Count > 0))
        {
            <a class="btn btn-primary" style="margin-top: var(--space-4);" href="/spaces">@Localizer["Calendars.GoToSpacesButton"]</a>
        }
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    [SupplyParameterFromQuery]
    private string? Provider { get; set; }

    private LinkedAccountService? linkedAccounts;
    private Guid userId;
    private bool loaded;
    private bool isBusy;
    private string? errorKey;
    private string? errorProviderName;
    private List<ProviderState> providers = [];

    private sealed class ProviderState
    {
        public required ProviderKind Provider { get; init; }
        public required string DisplayName { get; init; }
        public required string RouteSegment { get; init; }
        public bool IsLinked { get; set; }
        public IReadOnlyList<ExternalCalendar> Calendars { get; set; } = [];
    }

    protected override async Task OnInitializedAsync()
    {
        // Only registered when Key Vault + at least one provider's credentials are configured
        // (Program.cs) — resolved via the service provider rather than @inject so a missing
        // registration renders a message instead of throwing.
        linkedAccounts = ServiceProvider.GetService<LinkedAccountService>();
        if (linkedAccounts is null)
        {
            return;
        }

        errorKey = Error switch
        {
            "denied" => "Denied",
            "state" => "State",
            "exchange" => "Exchange",
            _ => null,
        };
        errorProviderName = Provider switch
        {
            "google" => "Google",
            "microsoft" => "Microsoft",
            _ => null,
        };

        var authState = await AuthenticationStateTask!;
        userId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        // Only a provider with an actually-registered ICalendarProvider gets a card — one
        // provider's credentials being unconfigured shouldn't offer a link button that would
        // fail the moment someone clicks it (Program.cs only registers what's configured).
        var availableProviders = ServiceProvider.GetServices<ICalendarProvider>().Select(p => p.Provider).ToHashSet();
        foreach (var (provider, displayName) in new[] { (ProviderKind.Google, "Google"), (ProviderKind.Microsoft, "Microsoft") })
        {
            if (!availableProviders.Contains(provider))
            {
                continue;
            }

            var state = new ProviderState
            {
                Provider = provider,
                DisplayName = displayName,
                RouteSegment = provider.ToString().ToLowerInvariant(),
                IsLinked = await linkedAccounts.IsLinkedAsync(userId, provider, CancellationToken.None),
            };

            if (state.IsLinked)
            {
                state.Calendars = await linkedAccounts.GetCalendarsAsync(userId, provider, CancellationToken.None);
            }

            providers.Add(state);
        }

        loaded = true;
    }

    private async Task ToggleAsync(Guid externalCalendarId, bool enabled)
    {
        if (isBusy || linkedAccounts is null)
        {
            return;
        }

        isBusy = true;
        try
        {
            await linkedAccounts.SetCalendarEnabledAsync(userId, externalCalendarId, enabled, CancellationToken.None);
            foreach (var state in providers.Where(p => p.IsLinked))
            {
                state.Calendars = await linkedAccounts.GetCalendarsAsync(userId, state.Provider, CancellationToken.None);
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task UnlinkAsync(ProviderKind provider)
    {
        if (isBusy || linkedAccounts is null)
        {
            return;
        }

        var state = providers.First(p => p.Provider == provider);
        if (!await JsRuntime.InvokeAsync<bool>("confirm", Localizer["Calendars.UnlinkConfirm", state.DisplayName].Value))
        {
            return;
        }

        isBusy = true;
        StateHasChanged();
        try
        {
            await linkedAccounts.UnlinkAsync(provider, userId, CancellationToken.None);
            state.IsLinked = false;
            state.Calendars = [];
        }
        finally
        {
            isBusy = false;
        }
    }
}
