@page "/spaces/{SpaceId:guid}/expenses"
@attribute [Authorize]

@using System.Globalization
@using System.Security.Claims
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Abstractions
@using Tessera.Core.Attachments
@using Tessera.Core.Expenses
@using Tessera.Core.Resources
@using Tessera.Core.Spaces
@using Tessera.Data
@using Tessera.Web.Services

@inject SpaceService SpaceService
@inject ExpenseService ExpenseService
@inject UsageService UsageService
@inject IAccessPolicy AccessPolicy
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IServiceProvider ServiceProvider
@inject ToastService ToastService
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["Expenses.PageTitle"]</PageTitle>

<div class="container">
    @if (space is null)
    {
        <p class="text-soft"><span class="spinner" aria-hidden="true"></span> @Localizer["Common.Loading"]</p>
    }
    else
    {
        <a href="/" class="text-soft">@Localizer["Common.BackToDashboard"]</a>
        <SpaceResourceHeader SpaceId="SpaceId" UserId="userId" Resource="ResourceKind.Expenses"
                              RouteSegment="expenses" ResourceTitleKey="Expenses.PageTitle" />
        <p class="text-soft">@Localizer["Expenses.ThisMonthTotal", MoneyFormatter.Format(monthlyTotal, currency, CultureInfo.CurrentUICulture.Name)]</p>

        @if (canWrite)
        {
            <div class="card max-w-32 mb-6">
                <EditForm Model="this" OnValidSubmit="RecordAsync">
                    <div class="stack stack-sm">
                        <input type="number" step="0.01" min="0" @bind="newAmount" placeholder="@Localizer["Expenses.AmountPlaceholder"]" class="form-control" />
                        <select @bind="newCategoryId" class="select-compact">
                            <option value="">@Localizer["Expenses.NoCategory"]</option>
                            @foreach (var category in categories)
                            {
                                <option value="@category.Id">@MessageProcessor.GetCategoryDisplayName(category, Localizer)</option>
                            }
                        </select>
                        <input @bind="newMerchant" placeholder="@Localizer["Expenses.MerchantPlaceholder"]" class="form-control" />
                        <input type="date" @bind="newDate" class="form-control" />
                        <button type="submit" class="btn btn-primary" disabled="@(isBusy || newAmount is null || newAmount <= 0)">
                            @if (isBusy) { <span class="spinner" aria-hidden="true"></span> }
                            @Localizer["Expenses.RecordButton"]
                        </button>
                    </div>
                </EditForm>
            </div>
        }

        <div class="card max-w-32 mb-6">
            <h2 class="mb-2">@Localizer["Expenses.Export.Heading"]</h2>
            @if (allowsExport)
            {
                <div class="stack stack-sm">
                    <label class="form-label" for="exportDateFrom">@Localizer["Expenses.Export.DateFromLabel"]</label>
                    <input type="date" id="exportDateFrom" @bind="exportDateFrom" class="form-control" />
                    <label class="form-label" for="exportDateTo">@Localizer["Expenses.Export.DateToLabel"]</label>
                    <input type="date" id="exportDateTo" @bind="exportDateTo" class="form-control" />
                    <label class="form-label" for="exportCategory">@Localizer["Expenses.Export.CategoryLabel"]</label>
                    <select id="exportCategory" @bind="exportCategoryId" class="select-compact">
                        <option value="">@Localizer["Expenses.Export.AllCategories"]</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@MessageProcessor.GetCategoryDisplayName(category, Localizer)</option>
                        }
                    </select>
                    <button type="button" class="btn btn-secondary" disabled="@isExporting" @onclick="GenerateExportAsync">
                        @if (isExporting) { <span class="spinner" aria-hidden="true"></span> }
                        @Localizer["Expenses.Export.GenerateButton"]
                    </button>
                    @if (exportDataUri is not null)
                    {
                        <a class="btn btn-primary" download="expenses.csv" href="@exportDataUri">@Localizer["Expenses.Export.DownloadButton"]</a>
                    }
                    else if (exportIsEmpty)
                    {
                        <p class="text-soft">@Localizer["Expenses.Export.NoResults"]</p>
                    }
                </div>
            }
            else
            {
                <p class="text-soft">@Localizer["Expenses.Export.RequiresPaidPlan"]</p>
                <a class="btn btn-secondary" href="/pricing">@Localizer["SpaceUsage.SeePlansButton"]</a>
            }
        </div>

        <div class="seam" aria-hidden="true">
            <span></span><span></span><span></span>
        </div>

        @if (recent.Count == 0)
        {
            <p class="text-soft">@Localizer["Expenses.PageEmpty"]</p>
        }
        else
        {
            <div class="stack stack-sm">
                @foreach (var expense in recent)
                {
                    <div class="card list-row">
                        <span class="list-row-label">@expense.Date.ToString("d", CultureInfo.CurrentUICulture)</span>
                        <span class="list-row-main">@(expense.Merchant ?? CategoryName(expense.CategoryId))</span>
                        <div class="list-row-actions">
                            <strong>@MoneyFormatter.Format(expense.Amount, expense.Currency, CultureInfo.CurrentUICulture.Name)</strong>
                            @if (attachmentsByExpense.TryGetValue(expense.Id, out var expenseAttachments) && expenseAttachments.Count > 0)
                            {
                                <button class="btn btn-secondary" @onclick="() => DownloadReceiptAsync(expenseAttachments[0].Id)">📎</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid SpaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Space? space;
    private Guid userId;
    private bool canWrite;
    private bool isBusy;
    private IReadOnlyList<Expense> recent = [];
    private IReadOnlyList<Category> categories = [];
    private decimal monthlyTotal;
    private string currency = "EUR";
    private decimal? newAmount;
    private Guid? newCategoryId;
    private string newMerchant = "";
    private DateOnly newDate = DateOnly.FromDateTime(DateTime.Today);
    private Dictionary<Guid, IReadOnlyList<Attachment>> attachmentsByExpense = [];

    private DateOnly? exportDateFrom;
    private DateOnly? exportDateTo;
    private Guid? exportCategoryId;
    private bool isExporting;
    private string? exportDataUri;
    private bool exportIsEmpty;
    private bool allowsExport;

    // Attachments are conditionally registered (Program.cs — only when BlobStorage:ConnectionString
    // is configured), same pattern as Notes.razor.
    private AttachmentService? AttachmentServiceOrNull => ServiceProvider.GetService<AttachmentService>();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        userId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        space = await SpaceService.GetByIdAsync(SpaceId, userId, CancellationToken.None);
        if (space is null || !await AccessPolicy.CanAsync(userId, SpaceId, ResourceKind.Expenses, AccessLevel.Read, CancellationToken.None))
        {
            NavigationManager.NavigateTo($"/spaces/{SpaceId}");
            return;
        }

        canWrite = await AccessPolicy.CanAsync(userId, SpaceId, ResourceKind.Expenses, AccessLevel.Write, CancellationToken.None);
        categories = await ExpenseService.GetCategoriesAsync(SpaceId, CancellationToken.None);
        var (_, _, plan) = await UsageService.GetTodayUsageAsync(SpaceId, CancellationToken.None);
        allowsExport = plan.AllowsExport;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        recent = await ExpenseService.GetRecentAsync(SpaceId, userId, 20, CancellationToken.None);
        var now = DateTime.UtcNow;
        (monthlyTotal, currency) = await ExpenseService.GetMonthlyTotalAsync(SpaceId, userId, now.Year, now.Month, CancellationToken.None);

        var attachments = AttachmentServiceOrNull;
        var byExpense = new Dictionary<Guid, IReadOnlyList<Attachment>>();
        if (attachments is not null)
        {
            foreach (var expense in recent)
            {
                byExpense[expense.Id] = await attachments.GetForAsync(ResourceKind.Expenses, expense.Id, CancellationToken.None);
            }
        }

        attachmentsByExpense = byExpense;
    }

    private async Task DownloadReceiptAsync(Guid attachmentId)
    {
        var attachments = AttachmentServiceOrNull;
        if (attachments is null)
        {
            return;
        }

        var url = await attachments.GetReadUrlAsync(attachmentId, TimeSpan.FromMinutes(5), CancellationToken.None);
        if (url is not null)
        {
            await JsRuntime.InvokeVoidAsync("open", url, "_blank");
        }
    }

    private async Task RecordAsync()
    {
        if (isBusy || newAmount is null || newAmount <= 0)
        {
            return;
        }

        isBusy = true;
        var recordedAmount = newAmount.Value;
        try
        {
            await ExpenseService.RecordAsync(
                SpaceId, userId, recordedAmount, newCategoryId,
                string.IsNullOrWhiteSpace(newMerchant) ? null : newMerchant.Trim(), newDate, note: null, CancellationToken.None);
            newAmount = null;
            newCategoryId = null;
            newMerchant = "";
            newDate = DateOnly.FromDateTime(DateTime.Today);
            await ReloadAsync();
            ToastService.ShowSuccess(Localizer["Expenses.ExpenseRecorded", MoneyFormatter.Format(recordedAmount, currency, CultureInfo.CurrentUICulture.Name)]);
        }
        catch (UnauthorizedAccessException)
        {
            ToastService.ShowError(Localizer["Expenses.GenericError"]);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task GenerateExportAsync()
    {
        if (isExporting)
        {
            return;
        }

        isExporting = true;
        exportDataUri = null;
        exportIsEmpty = false;
        try
        {
            var expenses = await ExpenseService.GetForExportAsync(SpaceId, userId, exportDateFrom, exportDateTo, exportCategoryId, CancellationToken.None);
            if (expenses.Count == 0)
            {
                exportIsEmpty = true;
                return;
            }

            var categoriesById = categories.ToDictionary(c => c.Id);
            var csv = ExpenseCsvExporter.Build(expenses, categoriesById, CultureInfo.CurrentUICulture, Localizer);
            exportDataUri = $"data:text/csv;base64,{Convert.ToBase64String(Encoding.UTF8.GetBytes(csv))}";
        }
        catch (UnauthorizedAccessException)
        {
            ToastService.ShowError(Localizer["Expenses.GenericError"]);
        }
        finally
        {
            isExporting = false;
        }
    }

    private string CategoryName(Guid? categoryId)
    {
        var category = categories.FirstOrDefault(c => c.Id == categoryId);
        return category is null ? Localizer["Expenses.NoCategory"] : MessageProcessor.GetCategoryDisplayName(category, Localizer);
    }
}
