@page "/"
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Abstractions
@using Tessera.Core.Calendars
@using Tessera.Core.Expenses
@using Tessera.Core.Notes
@using Tessera.Core.Reminders
@using Tessera.Core.Resources
@using Tessera.Core.Shopping
@using Tessera.Core.Spaces
@using Tessera.Data
@using Tessera.Web.Services

@inject SpaceService SpaceService
@inject ShoppingListService ShoppingListService
@inject ReminderService ReminderService
@inject ExpenseService ExpenseService
@inject NoteService NoteService
@inject IAccessPolicy AccessPolicy
@inject UserProvisioningService UserProvisioningService
@inject IServiceProvider ServiceProvider
@inject IStringLocalizer<Messages> Localizer

<PageTitle>Tessera</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container">
            <h1>@Localizer["Dashboard.Welcome", context.User.Identity?.Name ?? ""]</h1>
            <p class="text-soft">@Localizer["Dashboard.Subtitle"]</p>

            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            @if (previews is null)
            {
                <p class="text-soft"><span class="spinner" aria-hidden="true"></span> @Localizer["Common.Loading"]</p>
            }
            else if (previews.Count == 0)
            {
                <p class="text-soft">@Localizer["Dashboard.NoPreviews"]</p>
            }
            else
            {
                <div class="card" style="margin-bottom: var(--space-6);">
                    <h2 style="margin-bottom: var(--space-3);">@Localizer["Dashboard.TodayHeading"]</h2>
                    @if (todayItems.Count == 0)
                    {
                        <p class="text-soft" style="margin: 0;">@Localizer["Dashboard.TodayEmpty"]</p>
                    }
                    else
                    {
                        <ul style="margin: 0;">
                            @foreach (var item in todayItems)
                            {
                                <li>
                                    @item.Icon @MessageProcessor.FormatDueAt(item.At, timeZone!, CultureInfo.CurrentUICulture) — @item.Text
                                    @if (previews.Count > 1)
                                    {
                                        <span class="text-soft">(@item.SpaceName)</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>

                @if (previews.Count == 1)
                {
                    @SectionsGrid(previews[0])
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: var(--space-4);">
                        @foreach (var preview in previews)
                        {
                            <div class="card">
                                <a href="@($"/spaces/{preview.Space.Id}")" style="color: var(--ink);">
                                    <h3 style="margin-bottom: @(preview.OwnerDisplayName is null ? "var(--space-3)" : "0")">@preview.Space.Name</h3>
                                </a>
                                @if (preview.OwnerDisplayName is not null)
                                {
                                    <p class="text-soft" style="margin: 0 0 var(--space-3); font-size: var(--text-sm);">@Localizer["Spaces.SharedByLabel", preview.OwnerDisplayName]</p>
                                }
                                @SectionsGrid(preview)
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="hero">
            <div>
                <!-- The literal brand name is hardcoded, not localized, same as the navbar
                     wordmark (MainLayout.razor) — Google's OAuth verification checks that the
                     app name on the consent screen appears, as-is, next to a description of
                     what the app does, right on the home page (docs/07-compliance.md). -->
                <h1>Tessera: @Localizer["Landing.Tagline"]</h1>
                <p class="lead">@Localizer["Landing.Lead"]</p>
                <a class="btn btn-primary btn-lg" href="Account/Register">@Localizer["Landing.CtaPrimary"]</a>
                <a class="btn btn-secondary btn-lg" href="Account/Login" style="margin-left: var(--space-3);">@Localizer["Landing.CtaSecondary"]</a>
            </div>
            <div class="chat-mockup" aria-hidden="true">
                <span class="chat-bubble from-user">@Localizer["Landing.ChatUser1"]</span>
                <span class="chat-bubble from-bot">@Localizer["Landing.ChatBot1"]</span>
                <span class="chat-bubble from-user">@Localizer["Landing.ChatUser2"]</span>
                <span class="chat-bubble from-bot">@Localizer["Landing.ChatBot2"]</span>
            </div>
        </div>

        <div class="container">
            <div style="display: flex; gap: var(--space-4); flex-wrap: wrap; margin: var(--space-8) 0;">
                <div style="flex: 1; min-width: 14rem;">
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.TrustNoInstallTitle"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.TrustNoInstallBody"]</p>
                </div>
                <div style="flex: 1; min-width: 14rem;">
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.TrustSharedTitle"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.TrustSharedBody"]</p>
                </div>
                <div style="flex: 1; min-width: 14rem;">
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.TrustPrivacyTitle"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.TrustPrivacyBody"] <a href="/privacy">@Localizer["Landing.TrustPrivacyLink"]</a></p>
                </div>
            </div>

            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <h2>@Localizer["Landing.FeaturesHeading"]</h2>
            <div style="display: flex; gap: var(--space-4); flex-wrap: wrap; margin-top: var(--space-6);">
                <div class="card" style="flex: 1; min-width: 14rem;">
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.FeatureShoppingTitle"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.FeatureShoppingBody"]</p>
                </div>
                <div class="card" style="flex: 1; min-width: 14rem;">
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.FeatureRemindersTitle"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.FeatureRemindersBody"]</p>
                </div>
                <div class="card" style="flex: 1; min-width: 14rem;">
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.FeatureCalendarTitle"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.FeatureCalendarBody"]</p>
                </div>
                <div class="card" style="flex: 1; min-width: 14rem;">
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.FeatureNotesTitle"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.FeatureNotesBody"]</p>
                </div>
            </div>

            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <h2>@Localizer["Landing.HowItWorksHeading"]</h2>
            <div style="display: flex; gap: var(--space-6); flex-wrap: wrap; margin-top: var(--space-6);">
                <div style="flex: 1; min-width: 14rem;">
                    <p class="text-soft" style="font-family: var(--font-mono); margin-bottom: var(--space-2);">01</p>
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.Step1Title"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.Step1Body"]</p>
                </div>
                <div style="flex: 1; min-width: 14rem;">
                    <p class="text-soft" style="font-family: var(--font-mono); margin-bottom: var(--space-2);">02</p>
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.Step2Title"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.Step2Body"]</p>
                </div>
                <div style="flex: 1; min-width: 14rem;">
                    <p class="text-soft" style="font-family: var(--font-mono); margin-bottom: var(--space-2);">03</p>
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.Step3Title"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.Step3Body"]</p>
                </div>
            </div>

            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <div class="card" style="max-width: 32rem; margin: 0 auto; text-align: center;">
                <h2 style="margin-bottom: var(--space-2);">@Localizer["Landing.PricingTeaserHeading"]</h2>
                <p class="text-soft">@Localizer["Landing.PricingTeaserBody"]</p>
