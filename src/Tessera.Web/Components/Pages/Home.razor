            <div style="text-align: center; margin: var(--space-12) 0;">
                <a class="btn btn-primary btn-lg" href="Account/Register">@Localizer["Landing.CtaFinal"]</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // A null list means the user has no Read access to that resource in the space — the
    // section is hidden entirely. An empty (non-null) list means access exists but there's
    // nothing yet — the section still renders, with an empty-state message and a link into
    // the full page, so an empty category never disappears along with the way to fill it.
    // Events follows the same convention but is additionally null when no calendar provider
    // is configured at all (CalendarQueryService isn't registered — Program.cs).
    private sealed record SpacePreview(
        Space Space, string? OwnerDisplayName, IReadOnlyList<Reminder>? Reminders, IReadOnlyList<ShoppingItem>? ShoppingItems,
        IReadOnlyList<Expense>? Expenses, IReadOnlyList<Note>? Notes, IReadOnlyList<CalendarEventInfo>? Events);

    // Aggregated across every space, not just previewed within one — a reminder overdue or an
    // event today is the same "act on this" signal regardless of which space it's in, and
    // scanning 5 identical-looking boxes per space to find that isn't the point of a dashboard.
    private sealed record UrgentItem(string Icon, string Text, string SpaceName, DateTimeOffset At);

    private IReadOnlyList<SpacePreview>? previews;
    private IReadOnlyList<UrgentItem> todayItems = [];
    private TimeZoneInfo? timeZone;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var userId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);
        var user = await UserProvisioningService.GetAsync(userId, CancellationToken.None);
        timeZone = TimeZoneInfo.FindSystemTimeZoneById(user.TimeZoneId ?? "UTC");

        var spaces = await SpaceService.GetForUserWithOwnerNameAsync(userId, CancellationToken.None);
        var calendars = ServiceProvider.GetService<CalendarQueryService>();
        var result = new List<SpacePreview>();
        foreach (var (space, ownerName) in spaces)
        {
            IReadOnlyList<Reminder>? reminders = await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.Reminders, AccessLevel.Read, CancellationToken.None)
                ? (await ReminderService.GetPendingAsync(space.Id, userId, CancellationToken.None)).Take(3).ToList()
                : null;
            IReadOnlyList<ShoppingItem>? shoppingItems = await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.ShoppingList, AccessLevel.Read, CancellationToken.None)
                ? (await ShoppingListService.GetItemsAsync(space.Id, userId, listName: null, CancellationToken.None))
                    .Where(i => !i.IsChecked).Take(5).ToList()
                : null;
            IReadOnlyList<Expense>? expenses = await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.Expenses, AccessLevel.Read, CancellationToken.None)
                ? (await ExpenseService.GetRecentAsync(space.Id, userId, 3, CancellationToken.None)).ToList()
                : null;
            IReadOnlyList<Note>? notes = await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.Notes, AccessLevel.Read, CancellationToken.None)
                ? (await NoteService.GetNotesAsync(space.Id, userId, CancellationToken.None)).Take(3).ToList()
                : null;
            IReadOnlyList<CalendarEventInfo>? events = calendars is not null
                && await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.Calendar, AccessLevel.Read, CancellationToken.None)
                ? (await calendars.GetEventsAsync(space.Id, userId, DateTimeOffset.UtcNow, DateTimeOffset.UtcNow.AddDays(7), CancellationToken.None)).Take(3).ToList()
                : null;

            result.Add(new SpacePreview(space, ownerName, reminders, shoppingItems, expenses, notes, events));
        }

        previews = result;
        todayItems = BuildTodayItems(result, timeZone!);
    }

    // Only reminders due today-or-earlier and events starting today qualify — both lists are
    // already capped to a handful per space (the preview fetch above), so this reads what's
    // already loaded rather than issuing its own query, at the cost of possibly missing an
    // urgent item buried past the per-space preview cap. Acceptable for a glance, not a report.
    private static List<UrgentItem> BuildTodayItems(IReadOnlyList<SpacePreview> previews, TimeZoneInfo timeZone)
    {
        var todayLocalDate = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, timeZone).Date;
        var items = new List<UrgentItem>();

        foreach (var preview in previews)
        {
            if (preview.Reminders is not null)
            {
                items.AddRange(preview.Reminders
                    .Where(r => TimeZoneInfo.ConvertTime(r.DueAt, timeZone).Date <= todayLocalDate)
                    .Select(r => new UrgentItem("🔔", Truncate(r.Text), preview.Space.Name, r.DueAt)));
            }

            if (preview.Events is not null)
            {
                items.AddRange(preview.Events
                    .Where(e => TimeZoneInfo.ConvertTime(e.Start, timeZone).Date == todayLocalDate)
                    .Select(e => new UrgentItem("📅", Truncate(e.Title), preview.Space.Name, e.Start)));
            }
        }

        return items.OrderBy(x => x.At).Take(6).ToList();
    }

    private static string Truncate(string text) => text.Length <= 60 ? text : text[..60] + "…";

    // Non-empty categories sort first, so the eye lands on what actually needs attention
    // before the receded, dashed-border empty ones — same "add" access still one click away
    // through the header's link, just visually last instead of interrupting the scan.
    // OrderBy is stable, so ties (several empty, or several non-empty) keep the original
    // Reminders/Calendar/Shopping/Expenses/Notes order. Returns just the keys, not the markup
    // itself — building each section as its own RenderFragment value and reordering those
    // hits a Razor parser limitation with multiple @<tag> template literals sharing one method
    // body, so the grid below instead loops over these keys and picks which inline block to
    // render, keeping everything as one single top-level template.
    private static List<string> SectionOrder(SpacePreview preview)
    {
        var entries = new List<(string Key, bool IsEmpty)>();
        if (preview.Reminders is not null) { entries.Add(("reminders", preview.Reminders.Count == 0)); }
        if (preview.Events is not null) { entries.Add(("events", preview.Events.Count == 0)); }
        if (preview.ShoppingItems is not null) { entries.Add(("shopping", preview.ShoppingItems.Count == 0)); }
        if (preview.Expenses is not null) { entries.Add(("expenses", preview.Expenses.Count == 0)); }
        if (preview.Notes is not null) { entries.Add(("notes", preview.Notes.Count == 0)); }
        return entries.OrderBy(e => e.IsEmpty).Select(e => e.Key).ToList();
    }

    private RenderFragment SectionsGrid(SpacePreview preview) => @<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: var(--space-3);">
        @foreach (var key in SectionOrder(preview))
        {
            @if (key == "reminders")
            {
                var reminders = preview.Reminders!;
                <div class="dashboard-section @(reminders.Count == 0 ? "dashboard-section-empty" : "")">
                    <div style="margin-bottom: var(--space-1);">
                        <strong>🔔 @Localizer["Dashboard.RemindersHeading"]</strong>
                        <a href="@($"/spaces/{preview.Space.Id}/reminders")" style="font-size: var(--text-sm); margin-left: var(--space-2);">@Localizer["Dashboard.ViewAllReminders"]</a>
                    </div>
                    @if (reminders.Count > 0)
                    {
                        <ul style="margin: var(--space-1) 0 0;">
                            @foreach (var reminder in reminders)
                            {
                                <li>@MessageProcessor.FormatDueAt(reminder.DueAt, timeZone!, CultureInfo.CurrentUICulture) — @Truncate(reminder.Text)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-soft" style="margin: var(--space-1) 0 0;">@Localizer["Reminders.ListEmpty"]</p>
                    }
                </div>
            }
            else if (key == "events")
            {
                var events = preview.Events!;
                <div class="dashboard-section @(events.Count == 0 ? "dashboard-section-empty" : "")">
                    <div style="margin-bottom: var(--space-1);">
                        <strong>📅 @Localizer["Dashboard.CalendarHeading"]</strong>
                        <a href="@($"/spaces/{preview.Space.Id}/calendars")" style="font-size: var(--text-sm); margin-left: var(--space-2);">@Localizer["Dashboard.ManageCalendarsLink"]</a>
                    </div>
                    @if (events.Count > 0)
                    {
                        <ul style="margin: var(--space-1) 0 0;">
                            @foreach (var calendarEvent in events)
                            {
                                <li>@MessageProcessor.FormatDueAt(calendarEvent.Start, timeZone!, CultureInfo.CurrentUICulture) — @Truncate(calendarEvent.Title)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-soft" style="margin: var(--space-1) 0 0;">@Localizer["Calendars.EventsEmpty"]</p>
                    }
                </div>
            }
            else if (key == "shopping")
            {
                var shoppingItems = preview.ShoppingItems!;
                <div class="dashboard-section @(shoppingItems.Count == 0 ? "dashboard-section-empty" : "")">
                    <div style="margin-bottom: var(--space-1);">
                        <strong>🛒 @Localizer["Dashboard.ShoppingHeading"]</strong>
                        <a href="@($"/spaces/{preview.Space.Id}/shopping-list")" style="font-size: var(--text-sm); margin-left: var(--space-2);">@Localizer["Dashboard.ViewAllShoppingList"]</a>
                    </div>
                    @if (shoppingItems.Count > 0)
                    {
                        <ul style="margin: var(--space-1) 0 0;">
                            @foreach (var item in shoppingItems)
                            {
                                <li>@Truncate(item.RawText)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-soft" style="margin: var(--space-1) 0 0;">@Localizer["ShoppingList.Empty"]</p>
                    }
                </div>
            }
            else if (key == "expenses")
            {
                var expenses = preview.Expenses!;
                <div class="dashboard-section @(expenses.Count == 0 ? "dashboard-section-empty" : "")">
                    <div style="margin-bottom: var(--space-1);">
                        <strong>💶 @Localizer["Dashboard.ExpensesHeading"]</strong>
                        <a href="@($"/spaces/{preview.Space.Id}/expenses")" style="font-size: var(--text-sm); margin-left: var(--space-2);">@Localizer["Dashboard.ViewAllExpenses"]</a>
                    </div>
                    @if (expenses.Count > 0)
                    {
                        <ul style="margin: var(--space-1) 0 0;">
                            @foreach (var expense in expenses)
                            {
                                <li>@MoneyFormatter.Format(expense.Amount, expense.Currency, CultureInfo.CurrentUICulture.Name) — @(expense.Merchant ?? Localizer["Expenses.NoCategory"].Value)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-soft" style="margin: var(--space-1) 0 0;">@Localizer["Expenses.Empty"]</p>
                    }
                </div>
            }
            else if (key == "notes")
            {
                var notes = preview.Notes!;
                <div class="dashboard-section @(notes.Count == 0 ? "dashboard-section-empty" : "")">
                    <div style="margin-bottom: var(--space-1);">
                        <strong>🗒️ @Localizer["Dashboard.NotesHeading"]</strong>
                        <a href="@($"/spaces/{preview.Space.Id}/notes")" style="font-size: var(--text-sm); margin-left: var(--space-2);">@Localizer["Dashboard.ViewAllNotes"]</a>
                    </div>
                    @if (notes.Count > 0)
                    {
                        <ul style="margin: var(--space-1) 0 0;">
                            @foreach (var note in notes)
                            {
                                <li>@(string.IsNullOrEmpty(note.Title) ? Truncate(note.Body) : note.Title)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-soft" style="margin: var(--space-1) 0 0;">@Localizer["Notes.Empty"]</p>
                    }
                </div>
            }
        }
    </div>;
}
