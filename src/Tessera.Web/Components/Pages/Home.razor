@page "/"
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Abstractions
@using Tessera.Core.Calendars
@using Tessera.Core.Expenses
@using Tessera.Core.Notes
@using Tessera.Core.Reminders
@using Tessera.Core.Resources
@using Tessera.Core.Shopping
@using Tessera.Core.Spaces
@using Tessera.Data
@using Tessera.Web.Services

@inject SpaceService SpaceService
@inject ShoppingListService ShoppingListService
@inject ReminderService ReminderService
@inject ExpenseService ExpenseService
@inject NoteService NoteService
@inject IAccessPolicy AccessPolicy
@inject UserProvisioningService UserProvisioningService
@inject IServiceProvider ServiceProvider
@inject IStringLocalizer<Messages> Localizer

<PageTitle>Tessera</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container">
            <h1>@Localizer["Dashboard.Welcome", context.User.Identity?.Name ?? ""]</h1>
            <p class="text-soft">@Localizer["Dashboard.Subtitle"]</p>

            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            @if (previews is null)
            {
                <p class="text-soft"><span class="spinner" aria-hidden="true"></span> @Localizer["Common.Loading"]</p>
            }
            else if (previews.Count == 0)
            {
                <p class="text-soft">@Localizer["Dashboard.NoPreviews"]</p>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-6);">
                    @foreach (var preview in previews)
                    {
                        <div class="card">
                            <a href="@($"/spaces/{preview.Space.Id}")" style="color: var(--ink);">
                                <h3 style="margin-bottom: @(preview.OwnerDisplayName is null ? "var(--space-3)" : "0")">@preview.Space.Name</h3>
                            </a>
                            @if (preview.OwnerDisplayName is not null)
                            {
                                <p class="text-soft" style="margin: 0 0 var(--space-3); font-size: var(--text-sm);">@Localizer["Spaces.SharedByLabel", preview.OwnerDisplayName]</p>
                            }

                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: var(--space-3);">
                                @if (preview.Reminders is not null)
                                {
                                    <div class="dashboard-section">
                                        <div style="margin-bottom: var(--space-1);">
                                            <strong>@Localizer["Dashboard.RemindersHeading"]</strong>
                                            <a href="@($"/spaces/{preview.Space.Id}/reminders")" style="font-size: var(--text-sm); margin-left: var(--space-2);">@Localizer["Dashboard.ViewAllReminders"]</a>
                                        </div>
                                        @if (preview.Reminders.Count > 0)
                                        {
                                            <ul style="margin: var(--space-1) 0 0;">
                                                @foreach (var reminder in preview.Reminders)
                                                {
                                                    <li>@MessageProcessor.FormatDueAt(reminder.DueAt, timeZone!, CultureInfo.CurrentUICulture) — @Truncate(reminder.Text)</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="text-soft" style="margin: var(--space-1) 0 0;">@Localizer["Reminders.ListEmpty"]</p>
                                        }
                                    </div>
                                }

                                @if (preview.Events is not null)
                                {
                                    <div class="dashboard-section">
                                        <div style="margin-bottom: var(--space-1);">
                                            <strong>@Localizer["Dashboard.CalendarHeading"]</strong>
                                            <a href="@($"/spaces/{preview.Space.Id}/calendars")" style="font-size: var(--text-sm); margin-left: var(--space-2);">@Localizer["Dashboard.ManageCalendarsLink"]</a>
                                        </div>
                                        @if (preview.Events.Count > 0)
                                        {
                                            <ul style="margin: var(--space-1) 0 0;">
                                                @foreach (var calendarEvent in preview.Events)
                                                {
                                                    <li>@MessageProcessor.FormatDueAt(calendarEvent.Start, timeZone!, CultureInfo.CurrentUICulture) — @Truncate(calendarEvent.Title)</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="text-soft" style="margin: var(--space-1) 0 0;">@Localizer["Calendars.EventsEmpty"]</p>
                                        }
                                    </div>
                                }

                                @if (preview.ShoppingItems is not null)
                                {
                                    <div class="dashboard-section">
                                        <div style="margin-bottom: var(--space-1);">
                                            <strong>@Localizer["Dashboard.ShoppingHeading"]</strong>
                                            <a href="@($"/spaces/{preview.Space.Id}/shopping-list")" style="font-size: var(--text-sm); margin-left: var(--space-2);">@Localizer["Dashboard.ViewAllShoppingList"]</a>
                                        </div>
                                        @if (preview.ShoppingItems.Count > 0)
                                        {
                                            <ul style="margin: var(--space-1) 0 0;">
                                                @foreach (var item in preview.ShoppingItems)
                                                {
                                                    <li>@Truncate(item.RawText)</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="text-soft" style="margin: var(--space-1) 0 0;">@Localizer["ShoppingList.Empty"]</p>
                                        }
                                    </div>
                                }

                                @if (preview.Expenses is not null)
                                {
                                    <div class="dashboard-section">
                                        <div style="margin-bottom: var(--space-1);">
                                            <strong>@Localizer["Dashboard.ExpensesHeading"]</strong>
                                            <a href="@($"/spaces/{preview.Space.Id}/expenses")" style="font-size: var(--text-sm); margin-left: var(--space-2);">@Localizer["Dashboard.ViewAllExpenses"]</a>
                                        </div>
                                        @if (preview.Expenses.Count > 0)
                                        {
                                            <ul style="margin: var(--space-1) 0 0;">
                                                @foreach (var expense in preview.Expenses)
                                                {
                                                    <li>@MoneyFormatter.Format(expense.Amount, expense.Currency, CultureInfo.CurrentUICulture.Name) — @(expense.Merchant ?? Localizer["Expenses.NoCategory"].Value)</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="text-soft" style="margin: var(--space-1) 0 0;">@Localizer["Expenses.Empty"]</p>
                                        }
                                    </div>
                                }

                                @if (preview.Notes is not null)
                                {
                                    <div class="dashboard-section">
                                        <div style="margin-bottom: var(--space-1);">
                                            <strong>@Localizer["Dashboard.NotesHeading"]</strong>
                                            <a href="@($"/spaces/{preview.Space.Id}/notes")" style="font-size: var(--text-sm); margin-left: var(--space-2);">@Localizer["Dashboard.ViewAllNotes"]</a>
                                        </div>
                                        @if (preview.Notes.Count > 0)
                                        {
                                            <ul style="margin: var(--space-1) 0 0;">
                                                @foreach (var note in preview.Notes)
                                                {
                                                    <li>@(string.IsNullOrEmpty(note.Title) ? Truncate(note.Body) : note.Title)</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="text-soft" style="margin: var(--space-1) 0 0;">@Localizer["Notes.Empty"]</p>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <div style="display: flex; gap: var(--space-4); flex-wrap: wrap;">
                <a class="card" href="/spaces" style="flex: 1; min-width: 14rem; color: var(--ink);">
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Dashboard.SpacesTitle"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Dashboard.SpacesDescription"]</p>
                </a>
                <a class="card" href="/link/telegram" style="flex: 1; min-width: 14rem; color: var(--ink);">
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Dashboard.TelegramTitle"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Dashboard.TelegramDescription"]</p>
                </a>
                <a class="card" href="/calendars" style="flex: 1; min-width: 14rem; color: var(--ink);">
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Dashboard.CalendarsTitle"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Dashboard.CalendarsDescription"]</p>
                </a>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="hero">
            <div>
                <h1>@Localizer["Landing.Tagline"]</h1>
                <p class="lead">@Localizer["Landing.Lead"]</p>
                <a class="btn btn-primary btn-lg" href="Account/Register">@Localizer["Landing.CtaPrimary"]</a>
                <a class="btn btn-secondary btn-lg" href="Account/Login" style="margin-left: var(--space-3);">@Localizer["Landing.CtaSecondary"]</a>
            </div>
            <div class="chat-mockup" aria-hidden="true">
                <span class="chat-bubble from-user">@Localizer["Landing.ChatUser1"]</span>
                <span class="chat-bubble from-bot">@Localizer["Landing.ChatBot1"]</span>
                <span class="chat-bubble from-user">@Localizer["Landing.ChatUser2"]</span>
                <span class="chat-bubble from-bot">@Localizer["Landing.ChatBot2"]</span>
            </div>
        </div>

        <div class="container">
            <h2>@Localizer["Landing.FeaturesHeading"]</h2>
            <div style="display: flex; gap: var(--space-4); flex-wrap: wrap; margin-top: var(--space-6);">
                <div class="card" style="flex: 1; min-width: 14rem;">
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.FeatureShoppingTitle"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.FeatureShoppingBody"]</p>
                </div>
                <div class="card" style="flex: 1; min-width: 14rem;">
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.FeatureRemindersTitle"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.FeatureRemindersBody"]</p>
                </div>
                <div class="card" style="flex: 1; min-width: 14rem;">
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.FeatureCalendarTitle"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.FeatureCalendarBody"]</p>
                </div>
                <div class="card" style="flex: 1; min-width: 14rem;">
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.FeatureNotesTitle"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.FeatureNotesBody"]</p>
                </div>
            </div>

            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <h2>@Localizer["Landing.HowItWorksHeading"]</h2>
            <div style="display: flex; gap: var(--space-6); flex-wrap: wrap; margin-top: var(--space-6);">
                <div style="flex: 1; min-width: 14rem;">
                    <p class="text-soft" style="font-family: var(--font-mono); margin-bottom: var(--space-2);">01</p>
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.Step1Title"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.Step1Body"]</p>
                </div>
                <div style="flex: 1; min-width: 14rem;">
                    <p class="text-soft" style="font-family: var(--font-mono); margin-bottom: var(--space-2);">02</p>
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.Step2Title"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.Step2Body"]</p>
                </div>
                <div style="flex: 1; min-width: 14rem;">
                    <p class="text-soft" style="font-family: var(--font-mono); margin-bottom: var(--space-2);">03</p>
                    <h3 style="margin-bottom: var(--space-2);">@Localizer["Landing.Step3Title"]</h3>
                    <p class="text-soft" style="margin: 0;">@Localizer["Landing.Step3Body"]</p>
                </div>
            </div>

            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <div class="card" style="max-width: 32rem; margin: 0 auto; text-align: center;">
                <h2 style="margin-bottom: var(--space-2);">@Localizer["Landing.PricingTeaserHeading"]</h2>
                <p class="text-soft">@Localizer["Landing.PricingTeaserBody"]</p>
                <a href="/pricing">@Localizer["Landing.PricingTeaserLink"]</a>
            </div>

            <div style="text-align: center; margin: var(--space-12) 0;">
                <a class="btn btn-primary btn-lg" href="Account/Register">@Localizer["Landing.CtaFinal"]</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // A null list means the user has no Read access to that resource in the space — the
    // section is hidden entirely. An empty (non-null) list means access exists but there's
    // nothing yet — the section still renders, with an empty-state message and a link into
    // the full page, so an empty category never disappears along with the way to fill it.
    // Events follows the same convention but is additionally null when no calendar provider
    // is configured at all (CalendarQueryService isn't registered — Program.cs).
    private sealed record SpacePreview(
        Space Space, string? OwnerDisplayName, IReadOnlyList<Reminder>? Reminders, IReadOnlyList<ShoppingItem>? ShoppingItems,
        IReadOnlyList<Expense>? Expenses, IReadOnlyList<Note>? Notes, IReadOnlyList<CalendarEventInfo>? Events);

    private IReadOnlyList<SpacePreview>? previews;
    private TimeZoneInfo? timeZone;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var userId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);
        var user = await UserProvisioningService.GetAsync(userId, CancellationToken.None);
        timeZone = TimeZoneInfo.FindSystemTimeZoneById(user.TimeZoneId ?? "UTC");

        var spaces = await SpaceService.GetForUserWithOwnerNameAsync(userId, CancellationToken.None);
        var calendars = ServiceProvider.GetService<CalendarQueryService>();
        var result = new List<SpacePreview>();
        foreach (var (space, ownerName) in spaces)
        {
            IReadOnlyList<Reminder>? reminders = await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.Reminders, AccessLevel.Read, CancellationToken.None)
                ? (await ReminderService.GetPendingAsync(space.Id, userId, CancellationToken.None)).Take(3).ToList()
                : null;
            IReadOnlyList<ShoppingItem>? shoppingItems = await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.ShoppingList, AccessLevel.Read, CancellationToken.None)
                ? (await ShoppingListService.GetItemsAsync(space.Id, userId, listName: null, CancellationToken.None))
                    .Where(i => !i.IsChecked).Take(5).ToList()
                : null;
            IReadOnlyList<Expense>? expenses = await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.Expenses, AccessLevel.Read, CancellationToken.None)
                ? (await ExpenseService.GetRecentAsync(space.Id, userId, 3, CancellationToken.None)).ToList()
                : null;
            IReadOnlyList<Note>? notes = await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.Notes, AccessLevel.Read, CancellationToken.None)
                ? (await NoteService.GetNotesAsync(space.Id, userId, CancellationToken.None)).Take(3).ToList()
                : null;
            IReadOnlyList<CalendarEventInfo>? events = calendars is not null
                && await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.Calendar, AccessLevel.Read, CancellationToken.None)
                ? (await calendars.GetEventsAsync(space.Id, userId, DateTimeOffset.UtcNow, DateTimeOffset.UtcNow.AddDays(7), CancellationToken.None)).Take(3).ToList()
                : null;

            result.Add(new SpacePreview(space, ownerName, reminders, shoppingItems, expenses, notes, events));
        }

        previews = result;
    }

    private static string Truncate(string text) => text.Length <= 60 ? text : text[..60] + "…";
}
