@page "/"
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Abstractions
@using Tessera.Core.Calendars
@using Tessera.Core.Expenses
@using Tessera.Core.Notes
@using Tessera.Core.Reminders
@using Tessera.Core.Resources
@using Tessera.Core.Shopping
@using Tessera.Core.Spaces
@using Tessera.Core.Users
@using Tessera.Data
@using Tessera.Web.Services

@inject SpaceService SpaceService
@inject ShoppingListService ShoppingListService
@inject ReminderService ReminderService
@inject ExpenseService ExpenseService
@inject NoteService NoteService
@inject IAccessPolicy AccessPolicy
@inject UserProvisioningService UserProvisioningService
@inject LinkService LinkService
@inject IServiceProvider ServiceProvider
@inject IStringLocalizer<Messages> Localizer

<PageTitle>Tessera</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container">
            <h1>@Localizer["Dashboard.Welcome", greetingName ?? ""]</h1>
            <p class="text-soft">@Localizer["Dashboard.Subtitle"]</p>

            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            @if (previews is null)
            {
                <p class="text-soft"><span class="spinner" aria-hidden="true"></span> @Localizer["Common.Loading"]</p>
            }
            else if (previews.Count == 0)
            {
                <p class="text-soft">@Localizer["Dashboard.NoPreviews"]</p>
            }
            else
            {
                @if (gettingStarted.Any(s => !s.Done))
                {
                    <div class="card mb-6">
                        <h2 class="mb-space-3">@Localizer["Dashboard.GettingStartedHeading"]</h2>
                        <ul class="getting-started-list">
                            @foreach (var step in gettingStarted)
                            {
                                <li>
                                    @if (step.Done)
                                    {
                                        <span class="text-soft">✓ @Localizer[step.LabelKey]</span>
                                    }
                                    else
                                    {
                                        <a href="@step.Href">○ @Localizer[step.LabelKey]</a>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }

                <div class="card mb-6">
                    <h2 class="mb-space-3">@Localizer["Dashboard.TodayHeading"]</h2>
                    @if (todayItems.Count == 0)
                    {
                        <p class="text-soft m-0">@Localizer["Dashboard.TodayEmpty"]</p>
                    }
                    else
                    {
                        <ul class="m-0">
                            @foreach (var item in todayItems)
                            {
                                <li>
                                    @item.Icon @MessageProcessor.FormatDueAt(item.At, timeZone!, CultureInfo.CurrentUICulture) — @item.Text
                                    @if (previews.Count > 1)
                                    {
                                        <span class="text-soft">(@item.SpaceName)</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>

                @if (previews.Count == 1)
                {
                    @SectionsGrid(previews[0])
                }
                else
                {
                    <div class="space-preview-stack">
                        @foreach (var preview in previews)
                        {
                            <div class="card">
                                <a href="@($"/spaces/{preview.Space.Id}")" class="card-link">
                                    <h3 style="margin-bottom: @(preview.OwnerDisplayName is null ? "var(--space-3)" : "0")">@preview.Space.Name</h3>
                                </a>
                                @if (preview.OwnerDisplayName is not null)
                                {
                                    <p class="text-soft mb-space-3 text-sm">@Localizer["Spaces.SharedByLabel", preview.OwnerDisplayName]</p>
                                }
                                @SectionsGrid(preview)
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="hero">
            <div>
                <!-- The literal brand name is hardcoded, not localized, same as the navbar
                     wordmark (MainLayout.razor) — Google's OAuth verification checks that the
                     app name on the consent screen appears, as-is, next to a description of
                     what the app does, right on the home page (docs/07-compliance.md). -->
                <h1>Tessera: @Localizer["Landing.Tagline"]</h1>
                <p class="lead">@Localizer["Landing.Lead"]</p>
                <a class="btn btn-primary btn-lg" href="Account/Register">@Localizer["Landing.CtaPrimary"]</a>
                <a class="btn btn-secondary btn-lg ml-3" href="Account/Login">@Localizer["Landing.CtaSecondary"]</a>
            </div>
            <div class="chat-mockup" aria-hidden="true">
                <span class="chat-bubble from-user">@Localizer["Landing.ChatUser1"]</span>
                <span class="chat-bubble from-bot">@Localizer["Landing.ChatBot1"]</span>
                <span class="chat-bubble from-user">@Localizer["Landing.ChatUser2"]</span>
                <span class="chat-bubble from-bot">@Localizer["Landing.ChatBot2"]</span>
            </div>
        </div>

        <div class="container">
            <div class="card-grid mt-8 mb-8">
                <div class="grid-item">
                    <h3 class="mb-2">@Localizer["Landing.TrustNoInstallTitle"]</h3>
                    <p class="text-soft m-0">@Localizer["Landing.TrustNoInstallBody"]</p>
                </div>
                <div class="grid-item">
                    <h3 class="mb-2">@Localizer["Landing.TrustSharedTitle"]</h3>
                    <p class="text-soft m-0">@Localizer["Landing.TrustSharedBody"]</p>
                </div>
                <div class="grid-item">
                    <h3 class="mb-2">@Localizer["Landing.TrustPrivacyTitle"]</h3>
                    <p class="text-soft m-0">@Localizer["Landing.TrustPrivacyBody"] <a href="/privacy">@Localizer["Landing.TrustPrivacyLink"]</a></p>
                </div>
            </div>

            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <h2>@Localizer["Landing.FeaturesHeading"]</h2>
            <div class="card-grid mt-6">
                <div class="card grid-item">
                    <h3 class="mb-2">@Localizer["Landing.FeatureShoppingTitle"]</h3>
                    <p class="text-soft m-0">@Localizer["Landing.FeatureShoppingBody"]</p>
                </div>
                <div class="card grid-item">
                    <h3 class="mb-2">@Localizer["Landing.FeatureRemindersTitle"]</h3>
                    <p class="text-soft m-0">@Localizer["Landing.FeatureRemindersBody"]</p>
                </div>
                <div class="card grid-item">
                    <h3 class="mb-2">@Localizer["Landing.FeatureCalendarTitle"]</h3>
                    <p class="text-soft m-0">@Localizer["Landing.FeatureCalendarBody"]</p>
                </div>
                <div class="card grid-item">
                    <h3 class="mb-2">@Localizer["Landing.FeatureNotesTitle"]</h3>
                    <p class="text-soft m-0">@Localizer["Landing.FeatureNotesBody"]</p>
                </div>
            </div>

            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <h2>@Localizer["Landing.HowItWorksHeading"]</h2>
            <div class="how-it-works-row mt-6">
                <div class="grid-item">
                    <p class="text-soft step-number">01</p>
                    <h3 class="mb-2">@Localizer["Landing.Step1Title"]</h3>
                    <p class="text-soft m-0">@Localizer["Landing.Step1Body"]</p>
                </div>
                <div class="grid-item">
                    <p class="text-soft step-number">02</p>
                    <h3 class="mb-2">@Localizer["Landing.Step2Title"]</h3>
                    <p class="text-soft m-0">@Localizer["Landing.Step2Body"]</p>
                </div>
                <div class="grid-item">
                    <p class="text-soft step-number">03</p>
                    <h3 class="mb-2">@Localizer["Landing.Step3Title"]</h3>
                    <p class="text-soft m-0">@Localizer["Landing.Step3Body"]</p>
                </div>
            </div>

            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <div class="card max-w-32 pricing-teaser-card">
                <h2 class="mb-2">@Localizer["Landing.PricingTeaserHeading"]</h2>
                <p class="text-soft">@Localizer["Landing.PricingTeaserBody"]</p>
                <a href="/pricing">@Localizer["Landing.PricingTeaserLink"]</a>
            </div>

            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <FaqSection />

            <div class="final-cta">
                <a class="btn btn-primary btn-lg" href="Account/Register">@Localizer["Landing.CtaFinal"]</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // A null list means the user has no Read access to that resource in the space — the
    // section is hidden entirely. An empty (non-null) list means access exists but there's
    // nothing yet — the section still renders, with an empty-state message and a link into
    // the full page, so an empty category never disappears along with the way to fill it.
    // Events follows the same convention but is additionally null when no calendar provider
    // is configured at all (CalendarQueryService isn't registered — Program.cs).
    private sealed record SpacePreview(
        Space Space, string? OwnerDisplayName, IReadOnlyList<Reminder>? Reminders, IReadOnlyList<ShoppingItem>? ShoppingItems,
        IReadOnlyList<Expense>? Expenses, IReadOnlyList<Note>? Notes, IReadOnlyList<CalendarEventInfo>? Events);

    // Aggregated across every space, not just previewed within one — a reminder overdue or an
    // event today is the same "act on this" signal regardless of which space it's in, and
    // scanning 5 identical-looking boxes per space to find that isn't the point of a dashboard.
    private sealed record UrgentItem(string Icon, string Text, string SpaceName, DateTimeOffset At);

    private sealed record GettingStartedStep(string LabelKey, string Href, bool Done);

    private IReadOnlyList<SpacePreview>? previews;
    private IReadOnlyList<UrgentItem> todayItems = [];
    private IReadOnlyList<GettingStartedStep> gettingStarted = [];
    private TimeZoneInfo? timeZone;
    private string? greetingName;

    // ASP.NET Core Identity's own Name claim is the login username — the email address — never
    // fit to greet someone by (docs/13-piano-miglioramenti.md, B1). DisplayName is already
    // populated from Google's claims at signup and editable from /account
    // (docs/06-roadmap.md#login-social-e-profilo-utente); falling back to the email's local
    // part rather than the full address keeps the greeting personal without ever printing an
    // address on screen.
    private static string GreetingName(User user)
    {
        if (!string.IsNullOrWhiteSpace(user.DisplayName))
        {
            return user.DisplayName;
        }

        var atIndex = user.Email.IndexOf('@');
        return atIndex > 0 ? user.Email[..atIndex] : user.Email;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var userId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);
        var user = await UserProvisioningService.GetAsync(userId, CancellationToken.None);
        timeZone = TimeZoneInfo.FindSystemTimeZoneById(user.TimeZoneId ?? "UTC");
        greetingName = GreetingName(user);

        var spaces = await SpaceService.GetForUserWithOwnerNameAsync(userId, CancellationToken.None);
        var calendars = ServiceProvider.GetService<CalendarQueryService>();
        var result = new List<SpacePreview>();
        var hasSharedSpace = false;
        foreach (var (space, ownerName) in spaces)
        {
            // Space.IsPersonal is fixed at creation time and never flips when someone is
            // invited in later — it can't tell "shared" from "not shared" on its own, so this
            // checks actual membership count instead (docs/02-modello-dati.md).
            if (!hasSharedSpace && await SpaceService.GetMemberCountAsync(space.Id, CancellationToken.None) > 1)
            {
                hasSharedSpace = true;
            }

            IReadOnlyList<Reminder>? reminders = await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.Reminders, AccessLevel.Read, CancellationToken.None)
                ? (await ReminderService.GetPendingAsync(space.Id, userId, CancellationToken.None)).Take(3).ToList()
                : null;
            IReadOnlyList<ShoppingItem>? shoppingItems = await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.ShoppingList, AccessLevel.Read, CancellationToken.None)
                ? (await ShoppingListService.GetItemsAsync(space.Id, userId, listName: null, CancellationToken.None))
                    .Where(i => !i.IsChecked).Take(5).ToList()
                : null;
            IReadOnlyList<Expense>? expenses = await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.Expenses, AccessLevel.Read, CancellationToken.None)
                ? (await ExpenseService.GetRecentAsync(space.Id, userId, 3, CancellationToken.None)).ToList()
                : null;
            IReadOnlyList<Note>? notes = await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.Notes, AccessLevel.Read, CancellationToken.None)
                ? (await NoteService.GetNotesAsync(space.Id, userId, CancellationToken.None)).Take(3).ToList()
                : null;
            IReadOnlyList<CalendarEventInfo>? events = calendars is not null
                && await AccessPolicy.CanAsync(userId, space.Id, ResourceKind.Calendar, AccessLevel.Read, CancellationToken.None)
                ? (await calendars.GetEventsAsync(space.Id, userId, DateTimeOffset.UtcNow, DateTimeOffset.UtcNow.AddDays(7), CancellationToken.None)).Take(3).ToList()
                : null;

            result.Add(new SpacePreview(space, ownerName, reminders, shoppingItems, expenses, notes, events));
        }

        previews = result;
        todayItems = BuildTodayItems(result, timeZone!);

        var telegramLinked = await LinkService.IsChannelLinkedAsync(userId, "telegram", CancellationToken.None);
        var hasAnyContent = result.Any(p =>
            p.Reminders?.Count > 0 || p.ShoppingItems?.Count > 0 || p.Expenses?.Count > 0 || p.Notes?.Count > 0 || p.Events?.Count > 0);
        gettingStarted =
        [
            new GettingStartedStep("Dashboard.GettingStarted.LinkTelegram", "/link/telegram", telegramLinked),
            new GettingStartedStep("Dashboard.GettingStarted.AddFirstItem", "/chat", hasAnyContent),
            new GettingStartedStep("Dashboard.GettingStarted.ShareSpace", "/spaces", hasSharedSpace),
        ];
    }

    // Only reminders due today-or-earlier and events starting today qualify — both lists are
    // already capped to a handful per space (the preview fetch above), so this reads what's
    // already loaded rather than issuing its own query, at the cost of possibly missing an
    // urgent item buried past the per-space preview cap. Acceptable for a glance, not a report.
    private static List<UrgentItem> BuildTodayItems(IReadOnlyList<SpacePreview> previews, TimeZoneInfo timeZone)
    {
        var todayLocalDate = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, timeZone).Date;
        var items = new List<UrgentItem>();

        foreach (var preview in previews)
        {
            if (preview.Reminders is not null)
            {
                items.AddRange(preview.Reminders
                    .Where(r => TimeZoneInfo.ConvertTime(r.DueAt, timeZone).Date <= todayLocalDate)
                    .Select(r => new UrgentItem("🔔", Truncate(r.Text), preview.Space.Name, r.DueAt)));
            }

            if (preview.Events is not null)
            {
                items.AddRange(preview.Events
                    .Where(e => TimeZoneInfo.ConvertTime(e.Start, timeZone).Date == todayLocalDate)
                    .Select(e => new UrgentItem("📅", Truncate(e.Title), preview.Space.Name, e.Start)));
            }
        }

        return items.OrderBy(x => x.At).Take(6).ToList();
    }

    private static string Truncate(string text) => text.Length <= 60 ? text : text[..60] + "…";

    // Non-empty categories sort first, so the eye lands on what actually needs attention
    // before the receded, dashed-border empty ones — same "add" access still one click away
    // through the header's link, just visually last instead of interrupting the scan.
    // OrderBy is stable, so ties (several empty, or several non-empty) keep the original
    // Reminders/Calendar/Shopping/Expenses/Notes order. Returns just the keys, not the markup
    // itself — building each section as its own RenderFragment value and reordering those
    // hits a Razor parser limitation with multiple @<tag> template literals sharing one method
    // body, so the grid below instead loops over these keys and picks which inline block to
    // render, keeping everything as one single top-level template.
    private static List<string> SectionOrder(SpacePreview preview)
    {
        var entries = new List<(string Key, bool IsEmpty)>();
        if (preview.Reminders is not null) { entries.Add(("reminders", preview.Reminders.Count == 0)); }
        if (preview.Events is not null) { entries.Add(("events", preview.Events.Count == 0)); }
        if (preview.ShoppingItems is not null) { entries.Add(("shopping", preview.ShoppingItems.Count == 0)); }
        if (preview.Expenses is not null) { entries.Add(("expenses", preview.Expenses.Count == 0)); }
        if (preview.Notes is not null) { entries.Add(("notes", preview.Notes.Count == 0)); }
        return entries.OrderBy(e => e.IsEmpty).Select(e => e.Key).ToList();
    }

    private RenderFragment SectionsGrid(SpacePreview preview) => @<div class="sections-grid">
        @foreach (var key in SectionOrder(preview))
        {
            @if (key == "reminders")
            {
                var reminders = preview.Reminders!;
                <div class="dashboard-section @(reminders.Count == 0 ? "dashboard-section-empty" : "")">
                    <div class="mb-1">
                        <strong>🔔 @Localizer["Dashboard.RemindersHeading"]</strong>
                        <a href="@($"/spaces/{preview.Space.Id}/reminders")" class="dashboard-view-all-link">@Localizer["Dashboard.ViewAllReminders"]</a>
                    </div>
                    @if (reminders.Count > 0)
                    {
                        <ul class="mt-1 mb-0">
                            @foreach (var reminder in reminders)
                            {
                                <li>@MessageProcessor.FormatDueAt(reminder.DueAt, timeZone!, CultureInfo.CurrentUICulture) — @Truncate(reminder.Text)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-soft mt-1 mb-0">@Localizer["Reminders.ListEmpty"]</p>
                    }
                </div>
            }
            else if (key == "events")
            {
                var events = preview.Events!;
                <div class="dashboard-section @(events.Count == 0 ? "dashboard-section-empty" : "")">
                    <div class="mb-1">
                        <strong>📅 @Localizer["Dashboard.CalendarHeading"]</strong>
                        <a href="@($"/spaces/{preview.Space.Id}/calendars")" class="dashboard-view-all-link">@Localizer["Dashboard.ManageCalendarsLink"]</a>
                    </div>
                    @if (events.Count > 0)
                    {
                        <ul class="mt-1 mb-0">
                            @foreach (var calendarEvent in events)
                            {
                                <li>@MessageProcessor.FormatDueAt(calendarEvent.Start, timeZone!, CultureInfo.CurrentUICulture) — @Truncate(calendarEvent.Title)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-soft mt-1 mb-0">@Localizer["Calendars.EventsEmpty"]</p>
                    }
                </div>
            }
            else if (key == "shopping")
            {
                var shoppingItems = preview.ShoppingItems!;
                <div class="dashboard-section @(shoppingItems.Count == 0 ? "dashboard-section-empty" : "")">
                    <div class="mb-1">
                        <strong>🛒 @Localizer["Dashboard.ShoppingHeading"]</strong>
                        <a href="@($"/spaces/{preview.Space.Id}/shopping-list")" class="dashboard-view-all-link">@Localizer["Dashboard.ViewAllShoppingList"]</a>
                    </div>
                    @if (shoppingItems.Count > 0)
                    {
                        <ul class="mt-1 mb-0">
                            @foreach (var item in shoppingItems)
                            {
                                <li>@Truncate(item.RawText)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-soft mt-1 mb-0">@Localizer["ShoppingList.Empty"]</p>
                    }
                </div>
            }
            else if (key == "expenses")
            {
                var expenses = preview.Expenses!;
                <div class="dashboard-section @(expenses.Count == 0 ? "dashboard-section-empty" : "")">
                    <div class="mb-1">
                        <strong>💶 @Localizer["Dashboard.ExpensesHeading"]</strong>
                        <a href="@($"/spaces/{preview.Space.Id}/expenses")" class="dashboard-view-all-link">@Localizer["Dashboard.ViewAllExpenses"]</a>
                    </div>
                    @if (expenses.Count > 0)
                    {
                        <ul class="mt-1 mb-0">
                            @foreach (var expense in expenses)
                            {
                                <li>@MoneyFormatter.Format(expense.Amount, expense.Currency, CultureInfo.CurrentUICulture.Name) — @(expense.Merchant ?? Localizer["Expenses.NoCategory"].Value)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-soft mt-1 mb-0">@Localizer["Expenses.Empty"]</p>
                    }
                </div>
            }
            else if (key == "notes")
            {
                var notes = preview.Notes!;
                <div class="dashboard-section @(notes.Count == 0 ? "dashboard-section-empty" : "")">
                    <div class="mb-1">
                        <strong>🗒️ @Localizer["Dashboard.NotesHeading"]</strong>
                        <a href="@($"/spaces/{preview.Space.Id}/notes")" class="dashboard-view-all-link">@Localizer["Dashboard.ViewAllNotes"]</a>
                    </div>
                    @if (notes.Count > 0)
                    {
                        <ul class="mt-1 mb-0">
                            @foreach (var note in notes)
                            {
                                <li>@(string.IsNullOrEmpty(note.Title) ? Truncate(note.Body) : note.Title)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-soft mt-1 mb-0">@Localizer["Notes.Empty"]</p>
                    }
                </div>
            }
        }
    </div>;
}
