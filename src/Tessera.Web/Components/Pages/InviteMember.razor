@page "/spaces/{SpaceId:guid}/invite"
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Resources
@using Tessera.Core.Spaces
@using Tessera.Data

@inject SpaceService SpaceService
@inject InviteService InviteService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["InviteMember.Title"]</PageTitle>

<div class="container">
    <h1>@Localizer["InviteMember.Title"]@(space is not null ? $" — {space.Name}" : "")</h1>

    @if (inviteLink is not null)
    {
        <div class="card">
            <p>@Localizer["InviteMember.LinkGenerated"]</p>
            <input readonly value="@inviteLink" style="width: 100%; padding: var(--space-2); font-family: var(--font-mono); border: 1px solid var(--line); border-radius: var(--radius-sm);" onclick="this.select()" />
        </div>
    }
    else
    {
        <div class="card" style="max-width: 32rem;">
            <h2>@Localizer["InviteMember.PresetHeading"]</h2>
            <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                @foreach (var option in Presets)
                {
                    <label style="display: flex; align-items: center; gap: var(--space-2);">
                        <input type="radio" name="preset" checked="@(preset == option)" @onchange="() => preset = option" />
                        @Localizer[$"InviteMember.Preset.{option}"]
                    </label>
                }
            </div>

            @if (preset == "Custom")
            {
                <div style="margin-top: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3);">
                    <LevelPicker Label="@Localizer["ResourceKind.ShoppingList"].Value" @bind-Level="shoppingListLevel" />
                    <LevelPicker Label="@Localizer["ResourceKind.Expenses"].Value" @bind-Level="expensesLevel" />
                    <LevelPicker Label="@Localizer["ResourceKind.Reminders"].Value" @bind-Level="remindersLevel" />
                    <LevelPicker Label="@Localizer["ResourceKind.Notes"].Value" @bind-Level="notesLevel" />
                </div>
            }

            <button class="btn btn-primary" style="margin-top: var(--space-4);" disabled="@isBusy" @onclick="GenerateAsync">
                @if (isBusy) { <span class="spinner" aria-hidden="true"></span> }
                @Localizer["InviteMember.GenerateButton"]
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid SpaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private static readonly string[] Presets = ["Partner", "Family", "Friend", "Custom"];

    private Space? space;
    private Guid userId;
    private string preset = "Partner";
    private string? inviteLink;
    private bool isBusy;

    private AccessLevel shoppingListLevel = AccessLevel.Write;
    private AccessLevel expensesLevel = AccessLevel.Write;
    private AccessLevel remindersLevel = AccessLevel.Write;
    private AccessLevel notesLevel = AccessLevel.Write;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        userId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        space = await SpaceService.GetByIdAsync(SpaceId, userId, CancellationToken.None);
        if (space is null || !await SpaceService.IsOwnerAsync(SpaceId, userId, CancellationToken.None))
        {
            NavigationManager.NavigateTo($"/spaces/{SpaceId}");
        }
    }

    // Presets per docs/02-modello-dati.md — Calendar isn't usable yet (Fase 2), so "Custom"
    // has no Calendar control and always leaves it at None. Notes mirrors the ShoppingList
    // column in every preset: same kind of low-stakes shared content.
    private async Task GenerateAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            var (shopping, expenses, reminders, calendar, notes) = preset switch
            {
                "Partner" => (AccessLevel.Write, AccessLevel.Write, AccessLevel.Write, AccessLevel.Read, AccessLevel.Write),
                "Family" => (AccessLevel.Write, AccessLevel.None, AccessLevel.Write, AccessLevel.Availability, AccessLevel.Write),
                "Friend" => (AccessLevel.None, AccessLevel.None, AccessLevel.None, AccessLevel.Availability, AccessLevel.None),
                _ => (shoppingListLevel, expensesLevel, remindersLevel, AccessLevel.None, notesLevel),
            };

            var invite = await InviteService.CreateAsync(SpaceId, userId, shopping, expenses, reminders, calendar, notes, CancellationToken.None);
            inviteLink = $"{NavigationManager.BaseUri}invite/accept?token={invite.Token}";
        }
        finally
        {
            isBusy = false;
        }
    }
}
