@using Microsoft.Extensions.Localization
@using Tessera.Core.Resources
@using Tessera.Core.Spaces

@inject IStringLocalizer<Messages> Localizer

<label class="level-picker-label">
    <span>@Label</span>
    <select value="@Level" @onchange="OnChanged" class="level-picker-select">
        <option value="@AccessLevel.None">@Localizer["AccessLevel.None"]</option>
        <option value="@AccessLevel.Read">@Localizer["AccessLevel.Read"]</option>
        <option value="@AccessLevel.Write">@Localizer["AccessLevel.Write"]</option>
    </select>
</label>

@code {
    [Parameter]
    public string Label { get; set; } = "";

    [Parameter]
    public AccessLevel Level { get; set; }

    [Parameter]
    public EventCallback<AccessLevel> LevelChanged { get; set; }

    private Task OnChanged(ChangeEventArgs e) =>
        LevelChanged.InvokeAsync(Enum.Parse<AccessLevel>((string)e.Value!));
}
