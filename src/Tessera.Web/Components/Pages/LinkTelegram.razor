@page "/link/telegram"
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Resources
@using Tessera.Data

@inject LinkService LinkService
@inject IConfiguration Configuration
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["LinkTelegram.Title"]</PageTitle>

<div class="container">
    <h1>@Localizer["LinkTelegram.Title"]</h1>

    <div class="card" style="max-width: 32rem;">
        @if (deepLink is null)
        {
            <p>@Localizer["LinkTelegram.Intro"]</p>
            <button class="btn btn-primary" disabled="@isBusy" @onclick="GenerateLinkAsync">
                @if (isBusy) { <span class="spinner" aria-hidden="true"></span> }
                @Localizer["LinkTelegram.GenerateButton"]
            </button>
        }
        else
        {
            <p>@Localizer["LinkTelegram.OpenInstructions"]</p>
            <p><a href="@deepLink" target="_blank" class="text-mono">@deepLink</a></p>
            <button class="btn btn-secondary" disabled="@isBusy" @onclick="GenerateLinkAsync">
                @if (isBusy) { <span class="spinner" aria-hidden="true"></span> }
                @Localizer["LinkTelegram.RegenerateButton"]
            </button>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? deepLink;
    private bool isBusy;

    private async Task GenerateLinkAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            var authState = await AuthenticationStateTask!;
            var userId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

            var token = await LinkService.CreateTokenAsync(userId, "telegram", CancellationToken.None);
            var botUsername = Configuration["Telegram:BotUsername"];
            deepLink = $"https://t.me/{botUsername}?start={token.Token}";
        }
        finally
        {
            isBusy = false;
        }
    }
}
