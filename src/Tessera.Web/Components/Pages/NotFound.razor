@page "/not-found"
@using Microsoft.Extensions.Localization
@using Tessera.Core.Resources

@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["NotFound.Title"]</PageTitle>

<div class="container">
    <h1>@Localizer["NotFound.Title"]</h1>
    <p class="text-soft">@Localizer["NotFound.Body"] <a href="/">@Localizer["Common.BackToDashboard"]</a></p>
</div>
