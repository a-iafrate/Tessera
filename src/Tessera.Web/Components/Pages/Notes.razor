@page "/spaces/{SpaceId:guid}/notes"
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Abstractions
@using Tessera.Core.Attachments
@using Tessera.Core.Notes
@using Tessera.Core.Resources
@using Tessera.Core.Spaces
@using Tessera.Data

@inject SpaceService SpaceService
@inject NoteService NoteService
@inject IAccessPolicy AccessPolicy
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IServiceProvider ServiceProvider
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["Notes.PageTitle"]</PageTitle>

<div class="container">
    @if (space is null)
    {
        <p class="text-soft"><span class="spinner" aria-hidden="true"></span> @Localizer["Common.Loading"]</p>
    }
    else
    {
        <a href="/" class="text-soft">@Localizer["Common.BackToDashboard"]</a>
        <h1>@Localizer["Notes.PageTitle"] — @space.Name</h1>

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (canWrite)
        {
            <div class="card" style="max-width: 32rem; margin-bottom: var(--space-6);">
                <EditForm Model="this" OnValidSubmit="CreateAsync">
                    <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                        <input @bind="newTitle" placeholder="@Localizer["Notes.TitlePlaceholder"]"
                               style="padding: var(--space-2); border: 1px solid var(--line); border-radius: var(--radius-sm);" />
                        <textarea @bind="newBody" placeholder="@Localizer["Notes.BodyPlaceholder"]" rows="3"
                                  style="padding: var(--space-2); border: 1px solid var(--line); border-radius: var(--radius-sm); font-family: inherit;"></textarea>
                        <button type="submit" class="btn btn-primary" disabled="@(isBusy || string.IsNullOrWhiteSpace(newBody))">
                            @if (isBusy) { <span class="spinner" aria-hidden="true"></span> }
                            @Localizer["Notes.AddButton"]
                        </button>
                    </div>
                </EditForm>
            </div>
        }

        <div class="seam" aria-hidden="true">
            <span></span><span></span><span></span>
        </div>

        @if (notes.Count == 0)
        {
            <p class="text-soft">@Localizer["Notes.Empty"]</p>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: var(--space-3);">
                @foreach (var note in notes)
                {
                    <div class="card">
                        @if (editingNoteId == note.Id)
                        {
                            <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                                <input @bind="editTitle" placeholder="@Localizer["Notes.TitlePlaceholder"]"
                                       style="padding: var(--space-2); border: 1px solid var(--line); border-radius: var(--radius-sm);" />
                                <textarea @bind="editBody" rows="3"
                                          style="padding: var(--space-2); border: 1px solid var(--line); border-radius: var(--radius-sm); font-family: inherit;"></textarea>
                                <div style="display: flex; gap: var(--space-2);">
                                    <button class="btn btn-primary" disabled="@(isBusy || string.IsNullOrWhiteSpace(editBody))" @onclick="() => SaveEditAsync(note.Id)">
                                        @if (isBusy) { <span class="spinner" aria-hidden="true"></span> }
                                        @Localizer["Notes.SaveButton"]
                                    </button>
                                    <button class="btn btn-secondary" disabled="@isBusy" @onclick="CancelEdit">@Localizer["Notes.CancelButton"]</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(note.Title))
                            {
                                <strong>@note.Title</strong>
                            }
                            <p style="white-space: pre-wrap; margin: var(--space-2) 0;">@note.Body</p>
                            @if (attachmentsByNote.TryGetValue(note.Id, out var noteAttachments) && noteAttachments.Count > 0)
                            {
                                <ul style="list-style: none; padding: 0; margin: 0 0 var(--space-2) 0; display: flex; flex-direction: column; gap: var(--space-1);">
                                    @foreach (var attachment in noteAttachments)
                                    {
                                        <li>
                                            <button class="btn btn-secondary" disabled="@isBusy" @onclick="() => DownloadAttachmentAsync(attachment.Id)">
                                                📎 @attachment.FileName
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                            @if (canWrite)
                            {
                                <div style="display: flex; gap: var(--space-2);">
                                    <button class="btn btn-secondary" disabled="@isBusy" @onclick="() => StartEdit(note)">@Localizer["Notes.EditButton"]</button>
                                    <button class="btn btn-danger" disabled="@isBusy" @onclick="() => DeleteAsync(note.Id)">@Localizer["Notes.DeleteButton"]</button>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid SpaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Space? space;
    private Guid userId;
    private bool canWrite;
    private bool isBusy;
    private IReadOnlyList<Note> notes = [];
    private string newTitle = "";
    private string newBody = "";
    private Guid? editingNoteId;
    private string editTitle = "";
    private string editBody = "";
    private string? errorMessage;
    private Dictionary<Guid, IReadOnlyList<Attachment>> attachmentsByNote = [];

    // Attachments are conditionally registered (Program.cs — only when BlobStorage:AccountName
    // is configured), so this page must not fail to load for everyone when they're not.
    private AttachmentService? AttachmentServiceOrNull => ServiceProvider.GetService<AttachmentService>();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        userId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        space = await SpaceService.GetByIdAsync(SpaceId, userId, CancellationToken.None);
        if (space is null || !await AccessPolicy.CanAsync(userId, SpaceId, ResourceKind.Notes, AccessLevel.Read, CancellationToken.None))
        {
            NavigationManager.NavigateTo($"/spaces/{SpaceId}");
            return;
        }

        canWrite = await AccessPolicy.CanAsync(userId, SpaceId, ResourceKind.Notes, AccessLevel.Write, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        notes = await NoteService.GetNotesAsync(SpaceId, userId, CancellationToken.None);

        var attachments = AttachmentServiceOrNull;
        var byNote = new Dictionary<Guid, IReadOnlyList<Attachment>>();
        if (attachments is not null)
        {
            foreach (var note in notes)
            {
                byNote[note.Id] = await attachments.GetForAsync(ResourceKind.Notes, note.Id, CancellationToken.None);
            }
        }

        attachmentsByNote = byNote;
    }

    private async Task DownloadAttachmentAsync(Guid attachmentId)
    {
        var attachments = AttachmentServiceOrNull;
        if (attachments is null)
        {
            return;
        }

        var url = await attachments.GetReadUrlAsync(attachmentId, TimeSpan.FromMinutes(5), CancellationToken.None);
        if (url is not null)
        {
            await JsRuntime.InvokeVoidAsync("open", url, "_blank");
        }
    }

    private async Task CreateAsync()
    {
        if (isBusy || string.IsNullOrWhiteSpace(newBody))
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        try
        {
            await NoteService.CreateAsync(SpaceId, userId, string.IsNullOrWhiteSpace(newTitle) ? null : newTitle.Trim(), newBody.Trim(), CancellationToken.None);
            newTitle = "";
            newBody = "";
            await ReloadAsync();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = Localizer["Notes.GenericError"];
        }
        finally
        {
            isBusy = false;
        }
    }

    private void StartEdit(Note note)
    {
        editingNoteId = note.Id;
        editTitle = note.Title ?? "";
        editBody = note.Body;
    }

    private void CancelEdit()
    {
        editingNoteId = null;
    }

    private async Task SaveEditAsync(Guid noteId)
    {
        if (isBusy || string.IsNullOrWhiteSpace(editBody))
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        try
        {
            await NoteService.UpdateAsync(SpaceId, userId, noteId, string.IsNullOrWhiteSpace(editTitle) ? null : editTitle.Trim(), editBody.Trim(), CancellationToken.None);
            editingNoteId = null;
            await ReloadAsync();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = Localizer["Notes.GenericError"];
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteAsync(Guid noteId)
    {
        if (isBusy || !await JsRuntime.InvokeAsync<bool>("confirm", Localizer["Notes.DeleteConfirm"].Value))
        {
            return;
        }

        isBusy = true;
        StateHasChanged();
        errorMessage = null;
        try
        {
            await NoteService.DeleteAsync(SpaceId, userId, noteId, CancellationToken.None);
            if (AttachmentServiceOrNull is { } attachments)
            {
                await attachments.DeleteAllForAsync(ResourceKind.Notes, noteId, CancellationToken.None);
            }

            await ReloadAsync();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = Localizer["Notes.GenericError"];
        }
        finally
        {
            isBusy = false;
        }
    }
}
