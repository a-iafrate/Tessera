@page "/pricing"

@using System.Globalization
@using System.Security.Claims
@using Microsoft.ApplicationInsights
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Resources
@using Tessera.Core.Spaces
@using Tessera.Data
@using Tessera.Web.Services

@inject UsageService UsageService
@inject SpaceService SpaceService
@inject IServiceProvider ServiceProvider
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["Pricing.Title"]</PageTitle>

<div class="container pricing-container">
    <h1>@Localizer["Pricing.Title"]</h1>
    <p class="text-soft">@Localizer["Pricing.Intro"]</p>
    <p class="text-soft">@Localizer["Pricing.ReceiptScanningExplainer"]</p>

    @if (plans.Count == 0)
    {
        <p class="text-soft"><span class="spinner" aria-hidden="true"></span> @Localizer["Common.Loading"]</p>
    }
    else
    {
        <div class="card-grid mt-6">
            @foreach (var plan in plans)
            {
                <div class="card grid-item">
                    <h2>@plan.Name</h2>
                    <p class="plan-price">
                        @if (plan.MonthlyPrice == 0)
                        {
                            @Localizer["Pricing.Free"]
                        }
                        else
                        {
                            @MoneyFormatter.Format(plan.MonthlyPrice, plan.Currency, CultureInfo.CurrentUICulture.Name)
                            <span class="text-soft plan-price-suffix">@Localizer["Pricing.PerMonth"]</span>
                        }
                    </p>
                    <p class="text-soft">@Localizer[TaglineKey(plan)]</p>
                    <ul>
                        <li>@(IsUnlimited(plan.MaxReceiptsPerMonth) ? Localizer["Pricing.ReceiptsUnlimited"] : Localizer["Pricing.ReceiptsPerMonth", plan.MaxReceiptsPerMonth])</li>
                        <li>@(IsUnlimited(plan.MaxLinkedCalendars) ? Localizer["Pricing.CalendarsUnlimited"] : Localizer["Pricing.LinkedCalendars", plan.MaxLinkedCalendars])</li>
                        <li>@(plan.HistoryMonths <= 0 ? Localizer["Pricing.HistoryUnlimited"] : Localizer["Pricing.HistoryMonths", plan.HistoryMonths])</li>
                        <li>@(plan.AllowsExport ? Localizer["Pricing.ExportIncluded"] : Localizer["Pricing.ExportNotIncluded"])</li>
                        <li>@(IsUnlimited(plan.MaxSpacesOwned) ? Localizer["Pricing.SpacesUnlimited"] : Localizer["Pricing.SpacesOwned", plan.MaxSpacesOwned])</li>
                    </ul>
                </div>
            }
        </div>

        <div class="seam" aria-hidden="true">
            <span></span><span></span><span></span>
        </div>

        <h2>@Localizer["Pricing.FaqHeading"]</h2>
        <div class="faq-body max-w-40">
            <div class="mb-6">
                <h3 class="faq-question">@Localizer["Pricing.FaqStopPayingQuestion"]</h3>
                <p class="text-soft m-0">@Localizer["Pricing.FaqStopPayingAnswer"]</p>
            </div>
            <div>
                <h3 class="faq-question">@Localizer["Pricing.FaqPropagationQuestion"]</h3>
                <p class="text-soft m-0">@Localizer["Pricing.FaqPropagationAnswer"]</p>
            </div>
        </div>

        @if (isAuthenticated)
        {
            @if (ownedSpaces.Count > 0)
            {
                <div class="card max-w-32 mt-6">
                    <h2>@Localizer["Pricing.SubscribeHeading"]</h2>
                    <p class="text-soft">@Localizer["Pricing.SubscribeBody"]</p>
                    <div class="stack stack-sm mt-3">
                        @foreach (var s in ownedSpaces)
                        {
                            <a class="btn btn-primary" href="@($"/spaces/{s.Id}/usage")">@Localizer["Pricing.SubscribeLinkForSpace", s.Name]</a>
                        }
                    </div>
                </div>
            }
            else
            {
                <p class="text-soft mt-6">@Localizer["Pricing.NoOwnedSpaceNote"]</p>
            }
        }
        else
        {
            <p class="text-soft mt-6">
                @Localizer["Pricing.LoginToSubscribeNote"] <a href="Account/Login">@Localizer["Nav.LogIn"]</a>
            </p>
        }
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<SubscriptionPlan> plans = [];
    private bool isAuthenticated;
    private IReadOnlyList<Space> ownedSpaces = [];

    // Optional, same "degrades without Application Insights configured" shape as every other
    // consumer (Program.cs) — @inject would throw if nothing registered TelemetryClient, so this
    // goes through IServiceProvider like every other optional service in a page (e.g. Notes.razor's
    // AttachmentServiceOrNull).
    private TelemetryClient? TelemetryOrNull => ServiceProvider.GetService<TelemetryClient>();

    // 999 is the sentinel the seed data uses for "no practical cap" on these count axes
    // (Configurations/SubscriptionPlanConfiguration.cs) — HistoryMonths uses 0 instead, checked separately.
    private static bool IsUnlimited(int value) => value >= 999;

    // Plan-specific marketing copy keyed by id rather than by SubscriptionPlan.Name, since Name
    // is seed data an admin could rename without expecting the tagline to silently disappear.
    private static string TaglineKey(SubscriptionPlan plan) =>
        plan.Id == SystemPlanIds.Plus ? "Pricing.PlusTagline" : "Pricing.FreeTagline";

    protected override async Task OnInitializedAsync()
    {
        plans = await UsageService.GetAllPlansAsync(CancellationToken.None);

        var authState = await AuthenticationStateTask!;
        isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
        if (isAuthenticated)
        {
            var userId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);
            var spaces = await SpaceService.GetForUserAsync(userId, CancellationToken.None);

            // Only the owner manages billing for a space (SpaceUsage.razor has the same gate)
            // — a member with no ownership has nowhere to click through to yet.
            ownedSpaces = spaces.Where(x => x.OwnerId == userId).ToList();
        }

        // Once per page load, not per plan/render (docs/13-piano-miglioramenti.md, D3) — the
        // conversion funnel's first step: how many people ever see this page.
        TelemetryOrNull?.TrackEvent("PricingPageViewed", new Dictionary<string, string>
        {
            ["IsAuthenticated"] = isAuthenticated.ToString(),
        });
    }
}
