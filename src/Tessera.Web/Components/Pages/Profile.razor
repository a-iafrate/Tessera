@page "/account"
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Resources
@using Tessera.Core.Spaces
@using Tessera.Data
@using Tessera.Web.Services

@inject UserProvisioningService UserProvisioningService
@inject SpaceService SpaceService
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["Profile.Title"]</PageTitle>

<div class="container">
    <h1>@Localizer["Profile.Title"]</h1>

    @if (!loaded)
    {
        <p class="text-soft"><span class="spinner" aria-hidden="true"></span> @Localizer["Common.Loading"]</p>
    }
    else
    {
        @if (isBusy)
        {
            <p class="text-soft"><span class="spinner" aria-hidden="true"></span> @Localizer["Profile.Saving"]</p>
        }
        else if (statusMessage is not null)
        {
            <div class="alert alert-success">@statusMessage</div>
        }

        <div style="display: flex; gap: var(--space-4); flex-wrap: wrap;">
            <div class="card" style="flex: 1; min-width: 18rem;">
                <h2>@Localizer["Profile.NameHeading"]</h2>
                <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3);">
                    <UserAvatar DisplayName="@displayName" PictureUrl="@pictureUrl" Size="3" />
                    <div style="flex: 1;">
                        <div class="form-floating mb-3">
                            <input class="form-control" id="displayName" value="@displayName" disabled="@isBusy" @onchange="OnDisplayNameChangedAsync" />
                            <label for="displayName">@Localizer["Profile.NameLabel"]</label>
                        </div>
                    </div>
                </div>
                <div class="form-floating mb-3">
                    <input class="form-control" id="pictureUrl" value="@pictureUrl" disabled="@isBusy" @onchange="OnPictureUrlChangedAsync" />
                    <label for="pictureUrl">@Localizer["Profile.PictureUrlLabel"]</label>
                </div>
                <p class="text-soft">@Localizer["Profile.NameBody"]</p>
            </div>

            <div class="card" style="flex: 1; min-width: 18rem;">
                <h2>@Localizer["Profile.LanguageHeading"]</h2>
                <div class="form-floating mb-3">
                    <select class="form-control" id="culture" value="@culture" disabled="@isBusy" @onchange="OnCultureChangedAsync">
                        <option value="en">English</option>
                        <option value="it">Italiano</option>
                    </select>
                    <label for="culture">@Localizer["Profile.LanguageLabel"]</label>
                </div>
                <p class="text-soft">@Localizer["Profile.LanguageBody"]</p>
            </div>

            <div class="card" style="flex: 1; min-width: 18rem;">
                <h2>@Localizer["Profile.TimeZoneHeading"]</h2>
                <div class="form-floating mb-3">
                    <select class="form-control" id="timeZone" value="@(timeZoneId ?? "")" disabled="@isBusy" @onchange="OnTimeZoneChangedAsync">
                        <option value="">@Localizer["Profile.TimeZoneNotSet"]</option>
                        @foreach (var tz in CommonTimeZones.All)
                        {
                            <option value="@tz">@tz</option>
                        }
                    </select>
                    <label for="timeZone">@Localizer["Profile.TimeZoneLabel"]</label>
                </div>
                <p class="text-soft">@Localizer["Profile.TimeZoneBody"]</p>
            </div>

            @if (spaces.Count > 0)
            {
                <div class="card" style="flex: 1; min-width: 18rem;">
                    <h2>@Localizer["Profile.DefaultSpaceHeading"]</h2>
                    <div class="form-floating mb-3">
                        <select class="form-control" id="defaultSpace" value="@(defaultSpaceId?.ToString() ?? "")" disabled="@isBusy" @onchange="OnDefaultSpaceChangedAsync">
                            @foreach (var space in spaces)
                            {
                                <option value="@space.Id">@space.Name</option>
                            }
                        </select>
                        <label for="defaultSpace">@Localizer["Profile.DefaultSpaceLabel"]</label>
                    </div>
                    <p class="text-soft">@Localizer["Profile.DefaultSpaceBody"]</p>
                </div>
            }
        </div>

        <div class="seam" aria-hidden="true">
            <span></span><span></span><span></span>
        </div>

        <a class="btn btn-danger" href="/account/delete">@Localizer["Profile.DeleteAccountLink"]</a>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Guid userId;
    private bool loaded;
    private bool isBusy;
    private string? displayName;
    private string? pictureUrl;
    private string culture = "en";
    private string? timeZoneId;
    private Guid? defaultSpaceId;
    private IReadOnlyList<Space> spaces = [];
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        userId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        var user = await UserProvisioningService.GetAsync(userId, CancellationToken.None);
        displayName = user.DisplayName;
        pictureUrl = user.PictureUrl;
        culture = user.PreferredCulture;
        timeZoneId = user.TimeZoneId;
        defaultSpaceId = user.DefaultSpaceId;

        spaces = await SpaceService.GetForUserAsync(userId, CancellationToken.None);
        loaded = true;
    }

    private async Task OnDisplayNameChangedAsync(ChangeEventArgs e)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            displayName = e.Value?.ToString();
            await UserProvisioningService.SetDisplayNameAsync(userId, displayName, CancellationToken.None);
            statusMessage = Localizer["Profile.Saved"];
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OnPictureUrlChangedAsync(ChangeEventArgs e)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            pictureUrl = e.Value?.ToString();
            await UserProvisioningService.SetPictureUrlAsync(userId, pictureUrl, CancellationToken.None);
            statusMessage = Localizer["Profile.Saved"];
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OnCultureChangedAsync(ChangeEventArgs e)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            culture = e.Value?.ToString() ?? "en";
            await UserProvisioningService.SetPreferredCultureAsync(userId, culture, CancellationToken.None);
            statusMessage = Localizer["Profile.Saved"];
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OnTimeZoneChangedAsync(ChangeEventArgs e)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            var value = e.Value?.ToString();
            timeZoneId = string.IsNullOrEmpty(value) ? null : value;
            if (timeZoneId is not null)
            {
                await UserProvisioningService.SetTimeZoneAsync(userId, timeZoneId, CancellationToken.None);
                statusMessage = Localizer["Profile.Saved"];
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OnDefaultSpaceChangedAsync(ChangeEventArgs e)
    {
        if (isBusy)
        {
            return;
        }

        if (Guid.TryParse(e.Value?.ToString(), out var spaceId))
        {
            isBusy = true;
            try
            {
                defaultSpaceId = spaceId;
                await UserProvisioningService.SetDefaultSpaceAsync(userId, spaceId, CancellationToken.None);
                statusMessage = Localizer["Profile.Saved"];
            }
            finally
            {
                isBusy = false;
            }
        }
    }
}
