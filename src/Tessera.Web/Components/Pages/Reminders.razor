@page "/spaces/{SpaceId:guid}/reminders"
@attribute [Authorize]

@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Abstractions
@using Tessera.Core.Reminders
@using Tessera.Core.Resources
@using Tessera.Core.Spaces
@using Tessera.Data
@using Tessera.Web.Services

@inject SpaceService SpaceService
@inject ReminderService ReminderService
@inject IAccessPolicy AccessPolicy
@inject UserProvisioningService UserProvisioningService
@inject NavigationManager NavigationManager
@inject ToastService ToastService
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["Reminders.PageTitle"]</PageTitle>

<div class="container">
    @if (space is null)
    {
        <p class="text-soft"><span class="spinner" aria-hidden="true"></span> @Localizer["Common.Loading"]</p>
    }
    else
    {
        <a href="/" class="text-soft">@Localizer["Common.BackToDashboard"]</a>
        <SpaceResourceHeader SpaceId="SpaceId" UserId="userId" Resource="ResourceKind.Reminders"
                              RouteSegment="reminders" ResourceTitleKey="Reminders.PageTitle" />

        @if (canWrite)
        {
            <div class="card max-w-32 mb-6">
                <EditForm Model="this" OnValidSubmit="CreateAsync">
                    <div class="stack stack-sm">
                        <div class="form-floating">
                            <input class="form-control" id="newReminderText" @bind="newText" @bind:event="oninput"
                                   placeholder="@Localizer["Reminders.TextPlaceholder"]" />
                            <label for="newReminderText">@Localizer["Reminders.TextLabel"]</label>
                        </div>
                        <div class="inline-row">
                            <div class="flex-1">
                                <label for="newReminderDate" class="form-label">@Localizer["Reminders.DateLabel"]</label>
                                <input type="date" id="newReminderDate" class="form-control" @bind="newDate" />
                            </div>
                            <div class="flex-1">
                                <label for="newReminderTime" class="form-label">@Localizer["Reminders.TimeLabel"]</label>
                                <input type="time" id="newReminderTime" class="form-control" @bind="newTime" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary" disabled="@(isBusy || string.IsNullOrWhiteSpace(newText))">
                            @if (isBusy) { <span class="spinner" aria-hidden="true"></span> }
                            @Localizer["Reminders.AddButton"]
                        </button>
                    </div>
                </EditForm>
            </div>
        }

        <div class="seam" aria-hidden="true">
            <span></span><span></span><span></span>
        </div>

        @if (pending.Count == 0)
        {
            <p class="text-soft">@Localizer["Reminders.PageEmpty"]</p>
        }
        else
        {
            <div class="stack stack-sm">
                @foreach (var reminder in pending)
                {
                    <div class="card list-row">
                        <span class="list-row-label">@MessageProcessor.FormatDueAt(reminder.DueAt, timeZone!, CultureInfo.CurrentUICulture)</span>
                        <span class="list-row-main">@reminder.Text</span>
                        @if (canWrite)
                        {
                            <div class="list-row-actions">
                                <button class="btn btn-secondary" disabled="@isBusy" @onclick="() => CompleteAsync(reminder.Id)">@Localizer["Reminders.DoneButton"]</button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid SpaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Space? space;
    private Guid userId;
    private bool canWrite;
    private bool isBusy;
    private TimeZoneInfo? timeZone;
    private string timeZoneId = "UTC";
    private IReadOnlyList<Reminder> pending = [];
    private string newText = "";
    private DateOnly newDate = DateOnly.FromDateTime(DateTime.Today);
    private TimeOnly newTime = new(9, 0);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        userId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        space = await SpaceService.GetByIdAsync(SpaceId, userId, CancellationToken.None);
        if (space is null || !await AccessPolicy.CanAsync(userId, SpaceId, ResourceKind.Reminders, AccessLevel.Read, CancellationToken.None))
        {
            NavigationManager.NavigateTo($"/spaces/{SpaceId}");
            return;
        }

        canWrite = await AccessPolicy.CanAsync(userId, SpaceId, ResourceKind.Reminders, AccessLevel.Write, CancellationToken.None);

        var user = await UserProvisioningService.GetAsync(userId, CancellationToken.None);
        timeZoneId = user.TimeZoneId ?? "UTC";
        timeZone = TimeZoneInfo.FindSystemTimeZoneById(timeZoneId);

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        pending = await ReminderService.GetPendingAsync(SpaceId, userId, CancellationToken.None);
    }

    private async Task CreateAsync()
    {
        if (isBusy || string.IsNullOrWhiteSpace(newText))
        {
            return;
        }

        isBusy = true;
        var createdText = newText.Trim();
        try
        {
            var localDateTime = newDate.ToDateTime(newTime);
            var dueAt = new DateTimeOffset(localDateTime, timeZone!.GetUtcOffset(localDateTime));
            await ReminderService.CreateOnceAsync(SpaceId, userId, createdText, dueAt, timeZoneId, CancellationToken.None);
            newText = "";
            newDate = DateOnly.FromDateTime(DateTime.Today);
            newTime = new(9, 0);
            await ReloadAsync();
            ToastService.ShowSuccess(Localizer["Reminders.ReminderAdded", createdText]);
        }
        catch (UnauthorizedAccessException)
        {
            ToastService.ShowError(Localizer["Reminders.GenericError"]);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task CompleteAsync(Guid reminderId)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        var completedText = pending.FirstOrDefault(r => r.Id == reminderId)?.Text;
        try
        {
            await ReminderService.CompleteAsync(SpaceId, userId, reminderId, CancellationToken.None);
            await ReloadAsync();
            if (completedText is not null)
            {
                ToastService.ShowSuccess(Localizer["Reminders.ReminderCompleted", completedText]);
            }
        }
        catch (UnauthorizedAccessException)
        {
            ToastService.ShowError(Localizer["Reminders.GenericError"]);
        }
        finally
        {
            isBusy = false;
        }
    }
}
