@page "/settings"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Resources

@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["Settings.Title"]</PageTitle>

<div class="container">
    <h1>@Localizer["Settings.Title"]</h1>

    <div style="display: flex; gap: var(--space-4); flex-wrap: wrap; margin: var(--space-4) 0 var(--space-8);">
        <a class="card" href="/account" style="flex: 1; min-width: 14rem; color: var(--ink);">
            <h3 style="margin-bottom: var(--space-2);">@Localizer["Settings.ProfileCardTitle"]</h3>
            <p class="text-soft" style="margin: 0;">@Localizer["Settings.ProfileCardBody"]</p>
        </a>
        <a class="card" href="/calendars" style="flex: 1; min-width: 14rem; color: var(--ink);">
            <h3 style="margin-bottom: var(--space-2);">@Localizer["Settings.CalendarsCardTitle"]</h3>
            <p class="text-soft" style="margin: 0;">@Localizer["Settings.CalendarsCardBody"]</p>
        </a>
        <a class="card" href="/link/telegram" style="flex: 1; min-width: 14rem; color: var(--ink);">
            <h3 style="margin-bottom: var(--space-2);">@Localizer["Settings.TelegramCardTitle"]</h3>
            <p class="text-soft" style="margin: 0;">@Localizer["Settings.TelegramCardBody"]</p>
        </a>
    </div>

    <div class="seam" aria-hidden="true">
        <span></span><span></span><span></span>
    </div>

    <a class="btn btn-danger" href="/account/delete" style="margin-top: var(--space-4);">@Localizer["Profile.DeleteAccountLink"]</a>
</div>
