@page "/settings"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Resources

@inject IStringLocalizer<Messages> Localizer
@inject IJSRuntime JsRuntime
@inject IConfiguration Configuration

<PageTitle>@Localizer["Settings.Title"]</PageTitle>

<div class="container">
    <h1>@Localizer["Settings.Title"]</h1>

    <div class="card-grid mt-4 mb-8">
        <a class="card grid-item card-link" href="/account">
            <h3 class="mb-2">@Localizer["Settings.ProfileCardTitle"]</h3>
            <p class="text-soft m-0">@Localizer["Settings.ProfileCardBody"]</p>
        </a>
        <a class="card grid-item card-link" href="/account/change-password">
            <h3 class="mb-2">@Localizer["Settings.ChangePasswordCardTitle"]</h3>
            <p class="text-soft m-0">@Localizer["Settings.ChangePasswordCardBody"]</p>
        </a>
        <a class="card grid-item card-link" href="/calendars">
            <h3 class="mb-2">@Localizer["Settings.CalendarsCardTitle"]</h3>
            <p class="text-soft m-0">@Localizer["Settings.CalendarsCardBody"]</p>
        </a>
        <a class="card grid-item card-link" href="/link/telegram">
            <h3 class="mb-2">@Localizer["Settings.TelegramCardTitle"]</h3>
            <p class="text-soft m-0">@Localizer["Settings.TelegramCardBody"]</p>
        </a>
    </div>

    <div class="card max-w-32 mb-8">
        <h3 class="mb-2">@Localizer["Settings.ThemeTitle"]</h3>
        <p class="text-soft theme-body">@Localizer["Settings.ThemeBody"]</p>
        <div class="inline-row">
            <button type="button" class="@ThemeButtonClass("auto")" @onclick='() => SetThemeAsync("auto")'>@Localizer["Settings.ThemeAuto"]</button>
            <button type="button" class="@ThemeButtonClass("light")" @onclick='() => SetThemeAsync("light")'>@Localizer["Settings.ThemeLight"]</button>
            <button type="button" class="@ThemeButtonClass("dark")" @onclick='() => SetThemeAsync("dark")'>@Localizer["Settings.ThemeDark"]</button>
        </div>
    </div>

    @if (VapidPublicKey is not null)
    {
        <div class="card max-w-32 mb-8">
            <h3 class="mb-2">@Localizer["Settings.NotificationsTitle"]</h3>
            <p class="text-soft">@Localizer["Settings.NotificationsBody"]</p>
            @switch (pushStatus)
            {
                case "subscribed":
                    <button type="button" class="btn btn-secondary" disabled="@pushBusy" @onclick="DisablePushAsync">@Localizer["Settings.NotificationsDisableButton"]</button>
                    break;
                case "denied":
                    <p class="text-soft">@Localizer["Settings.NotificationsDenied"]</p>
                    break;
                case "unsupported":
                    <p class="text-soft">@Localizer["Settings.NotificationsUnsupported"]</p>
                    break;
                default:
                    <button type="button" class="btn btn-primary" disabled="@pushBusy" @onclick="EnablePushAsync">@Localizer["Settings.NotificationsEnableButton"]</button>
                    break;
            }
        </div>
    }

    <div class="seam" aria-hidden="true">
        <span></span><span></span><span></span>
    </div>

    <a class="btn btn-danger mt-4" href="/account/delete">@Localizer["Profile.DeleteAccountLink"]</a>
</div>

@code {
    // Read via JS interop, not from a cookie/claim — the theme choice lives only in the
    // browser's localStorage (theme.js), same as it's applied before first paint in
    // App.razor's inline script (docs/13-piano-miglioramenti.md, B2). Defaults to "auto"
    // until OnAfterRenderAsync's first pass can actually reach the JS runtime.
    private string currentTheme = "auto";

    // Null hides the whole card — same "opt-in integration, degrades gracefully" shape as every
    // other optional integration in Program.cs (docs/13-piano-miglioramenti.md, C2): without a
    // configured VAPID key, there's nothing push.js could subscribe to anyway.
    private string? VapidPublicKey => Configuration["WebPush:VapidPublicKey"];

    // "unsubscribed" until OnAfterRenderAsync's first pass can ask the browser — this is
    // per-device state (a service worker subscription), never server state.
    private string pushStatus = "unsubscribed";
    private bool pushBusy;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            currentTheme = await JsRuntime.InvokeAsync<string>("tesseraTheme.get");
            if (VapidPublicKey is not null)
            {
                pushStatus = await JsRuntime.InvokeAsync<string>("tesseraPush.getStatus");
            }

            StateHasChanged();
        }
    }

    private async Task EnablePushAsync()
    {
        if (pushBusy || VapidPublicKey is null)
        {
            return;
        }

        pushBusy = true;
        try
        {
            pushStatus = await JsRuntime.InvokeAsync<string>("tesseraPush.subscribe", VapidPublicKey);
        }
        finally
        {
            pushBusy = false;
        }
    }

    private async Task DisablePushAsync()
    {
        if (pushBusy)
        {
            return;
        }

        pushBusy = true;
        try
        {
            pushStatus = await JsRuntime.InvokeAsync<string>("tesseraPush.unsubscribe");
        }
        finally
        {
            pushBusy = false;
        }
    }

    private async Task SetThemeAsync(string theme)
    {
        await JsRuntime.InvokeVoidAsync("tesseraTheme.set", theme);
        currentTheme = theme;
    }

    private string ThemeButtonClass(string theme) =>
        theme == currentTheme ? "btn btn-primary" : "btn btn-secondary";
}
