@page "/spaces/{SpaceId:guid}/shopping-list"
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Abstractions
@using Tessera.Core.Resources
@using Tessera.Core.Shopping
@using Tessera.Core.Spaces
@using Tessera.Data

@inject SpaceService SpaceService
@inject ShoppingListService ShoppingListService
@inject IAccessPolicy AccessPolicy
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["ShoppingList.PageTitle"]</PageTitle>

<div class="container">
    @if (space is null)
    {
        <p class="text-soft"><span class="spinner" aria-hidden="true"></span> @Localizer["Common.Loading"]</p>
    }
    else
    {
        <a href="/" class="text-soft">@Localizer["Common.BackToDashboard"]</a>
        <h1>@Localizer["ShoppingList.PageTitle"] — @space.Name</h1>

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        @if (canWrite)
        {
            <div class="card" style="max-width: 32rem; margin-bottom: var(--space-6);">
                <EditForm Model="this" OnValidSubmit="AddAsync">
                    <div style="display: flex; gap: var(--space-2);">
                        <input @bind="newItemText" placeholder="@Localizer["ShoppingList.AddPlaceholder"]"
                               style="flex: 1; padding: var(--space-2); border: 1px solid var(--line); border-radius: var(--radius-sm);" />
                        <button type="submit" class="btn btn-primary" disabled="@(isAdding || string.IsNullOrWhiteSpace(newItemText))">
                            @if (isAdding) { <span class="spinner" aria-hidden="true"></span> }
                            @Localizer["ShoppingList.AddButton"]
                        </button>
                    </div>
                </EditForm>
            </div>
        }

        <div class="seam" aria-hidden="true">
            <span></span><span></span><span></span>
        </div>

        @if (items.Count == 0)
        {
            <p class="text-soft">@Localizer["ShoppingList.Empty"]</p>
        }
        else
        {
            @if (UncheckedItems.Count > 0)
            {
                <p class="text-soft shopping-count">@Localizer["ShoppingList.Count", UncheckedItems.Count]</p>
            }

            <ul class="shopping-rows">
                @foreach (var item in UncheckedItems)
                {
                    @RenderRow(item)
                }
            </ul>

            @if (CheckedItems.Count > 0)
            {
                <h2 class="shopping-checked-heading">@Localizer["ShoppingList.AlreadyGot", CheckedItems.Count]</h2>
                <ul class="shopping-rows">
                    @foreach (var item in CheckedItems)
                    {
                        @RenderRow(item)
                    }
                </ul>
            }

            @if (canWrite)
            {
                <div class="seam" aria-hidden="true">
                    <span></span><span></span><span></span>
                </div>
                <button class="btn btn-danger" disabled="@isClearing" @onclick="ClearAsync">
                    @if (isClearing) { <span class="spinner" aria-hidden="true"></span> }
                    @Localizer["ShoppingList.ClearButton"]
                </button>
            }
        }
    }
</div>

@code {
    [Parameter]
    public Guid SpaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Space? space;
    private Guid userId;
    private bool canWrite;
    private bool isAdding;
    private bool isClearing;
    private string newItemText = "";
    private string? errorMessage;

    // A mutable list, not the read-only snapshot GetItemsAsync returns directly — toggling or
    // removing one row updates this in place (optimistic, with rollback on failure) instead of
    // re-fetching and re-rendering every other row's busy state along with it
    // (docs/13-piano-miglioramenti.md, B3: a global isBusy flag froze the whole list while any
    // single row's request was in flight).
    private List<ShoppingItem> items = [];

    // Only the row currently in flight is disabled — every other row stays fully interactive,
    // the exact behavior B3 asks for ("spuntare tre voci di seguito su telefono non blocca la
    // lista").
    private readonly HashSet<Guid> busyItemIds = [];

    // Recomputed on every access rather than cached — list sizes here are a handful of items,
    // and caching would need its own invalidation on every optimistic mutation below, which is
    // more bookkeeping than the recomputation itself costs.
    private List<ShoppingItem> UncheckedItems => items.Where(i => !i.IsChecked).ToList();
    private List<ShoppingItem> CheckedItems => items.Where(i => i.IsChecked).ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        userId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        space = await SpaceService.GetByIdAsync(SpaceId, userId, CancellationToken.None);
        if (space is null || !await AccessPolicy.CanAsync(userId, SpaceId, ResourceKind.ShoppingList, AccessLevel.Read, CancellationToken.None))
        {
            NavigationManager.NavigateTo($"/spaces/{SpaceId}");
            return;
        }

        canWrite = await AccessPolicy.CanAsync(userId, SpaceId, ResourceKind.ShoppingList, AccessLevel.Write, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        items = (await ShoppingListService.GetItemsAsync(SpaceId, userId, listName: null, CancellationToken.None)).ToList();
    }

    private async Task AddAsync()
    {
        if (isAdding || string.IsNullOrWhiteSpace(newItemText))
        {
            return;
        }

        isAdding = true;
        errorMessage = null;
        try
        {
            await ShoppingListService.AddItemAsync(SpaceId, userId, newItemText.Trim(), listName: null, CancellationToken.None);
            newItemText = "";
            await ReloadAsync();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = Localizer["ShoppingList.GenericError"];
        }
        finally
        {
            isAdding = false;
        }
    }

    // A real toggle, both directions optimistic with rollback — checking off an item by
    // mistake (or a member wanting to put something back on the list) must not be a dead end
    // in the console, which has no undo button of its own. The bot's own inline keyboard stays
    // one-way on purpose (checking there is final, reversible only through /undo's short
    // per-user window — docs/10-conversazione.md); this is the console's equivalent of that
    // same undo, just always available instead of time-limited.
    private async Task ToggleCheckedAsync(ShoppingItem item)
    {
        if (!busyItemIds.Add(item.Id))
        {
            return;
        }

        errorMessage = null;
        var wasChecked = item.IsChecked;
        item.IsChecked = !wasChecked;
        StateHasChanged();

        try
        {
            var updated = wasChecked
                ? await ShoppingListService.UncheckItemByIdAsync(SpaceId, userId, item.Id, CancellationToken.None)
                : await ShoppingListService.CheckItemByIdAsync(SpaceId, userId, item.Id, CancellationToken.None);
            if (updated is null)
            {
                // Already in the target state, or removed, by someone else in the meantime —
                // reload to pick up whatever the true state actually is rather than trust the
                // optimistic guess.
                await ReloadAsync();
            }
        }
        catch (UnauthorizedAccessException)
        {
            item.IsChecked = wasChecked;
            errorMessage = Localizer["ShoppingList.GenericError"];
        }
        finally
        {
            busyItemIds.Remove(item.Id);
        }
    }

    private async Task RemoveAsync(ShoppingItem item)
    {
        if (!busyItemIds.Add(item.Id))
        {
            return;
        }

        errorMessage = null;
        var index = items.IndexOf(item);
        items.Remove(item);
        StateHasChanged();

        try
        {
            var removed = await ShoppingListService.RemoveItemByIdAsync(SpaceId, userId, item.Id, CancellationToken.None);
            if (removed is null)
            {
                // Already removed by someone else — reconcile with the server rather than
                // leave a row missing that might not actually be gone.
                await ReloadAsync();
            }
        }
        catch (UnauthorizedAccessException)
        {
            items.Insert(Math.Min(index, items.Count), item);
            errorMessage = Localizer["ShoppingList.GenericError"];
        }
        finally
        {
            busyItemIds.Remove(item.Id);
        }
    }

    private async Task ClearAsync()
    {
        if (isClearing || !await JsRuntime.InvokeAsync<bool>("confirm", Localizer["ShoppingList.ClearConfirm"].Value))
        {
            return;
        }

        isClearing = true;
        StateHasChanged();
        errorMessage = null;
        try
        {
            await ShoppingListService.ClearAsync(SpaceId, userId, listName: null, CancellationToken.None);
            await ReloadAsync();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = Localizer["ShoppingList.GenericError"];
        }
        finally
        {
            isClearing = false;
        }
    }

    // @key is essential here, not decorative: the two @foreach loops below re-render whenever
    // an item moves between UncheckedItems and CheckedItems (recomputed on every access), and
    // without a stable per-item key Blazor's default position-based diff can leave a
    // checkbox's native checked DOM property behind on the wrong row after a reorder — the
    // text/strikethrough update correctly (they're plain attribute diffs), but the checkbox
    // itself visually shows the previous occupant's state. Caught via manual verification
    // (docs/13-piano-miglioramenti.md, B3), not by any build or test.
    private RenderFragment RenderRow(ShoppingItem item) => @<li class="shopping-row" @key="item.Id">
        <label class="shopping-row-label">
            <input type="checkbox" class="shopping-row-checkbox"
                   checked="@item.IsChecked" disabled="@(!canWrite || busyItemIds.Contains(item.Id))"
                   @onchange="() => ToggleCheckedAsync(item)" />
            <span class="@(item.IsChecked ? "shopping-row-text shopping-row-text-checked" : "shopping-row-text")">@item.RawText</span>
        </label>
        @if (canWrite)
        {
            <button type="button" class="shopping-row-remove" disabled="@busyItemIds.Contains(item.Id)"
                    aria-label="@Localizer["ShoppingList.RemoveButton"]" @onclick="() => RemoveAsync(item)">
                ✕
            </button>
        }
    </li>;
}
