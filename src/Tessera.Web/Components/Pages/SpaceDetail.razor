@page "/spaces/{SpaceId:guid}"
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Resources
@using Tessera.Core.Spaces
@using Tessera.Data

@inject SpaceService SpaceService
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@(space?.Name ?? Localizer["SpaceDetail.Title"].Value)</PageTitle>

<div class="container">
    @if (space is null)
    {
        <p class="text-soft">@Localizer["Common.Loading"]</p>
    }
    else
    {
        <h1>@space.Name</h1>
        @if (space.IsPersonal)
        {
            <p class="text-soft">@Localizer["SpaceDetail.PersonalNote"]</p>
        }

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="seam" aria-hidden="true">
            <span></span><span></span><span></span>
        </div>

        <h2>@Localizer["SpaceDetail.MembersHeading"]</h2>
        <div style="display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-8);">
            @foreach (var (membership, displayName) in members)
            {
                <div class="card">
                    <strong>@displayName</strong>
                    @if (membership.UserId == currentUserId)
                    {
                        <span class="text-soft">@Localizer["SpaceDetail.YouTag"]</span>
                    }
                    <div style="margin-top: var(--space-2); display: flex; gap: var(--space-2); flex-wrap: wrap;">
                        @if (membership.IsOwner)
                        {
                            <span class="badge badge-admin">@Localizer["AccessLevel.Admin"]</span>
                        }
                        else
                        {
                            @foreach (var permission in membership.Permissions)
                            {
                                <span class="badge @BadgeClass(permission.Level)">
                                    @ResourceName(permission.Resource): @LevelName(permission.Level)
                                </span>
                            }
                        }
                    </div>

                    @if (isOwner && membership.UserId != currentUserId)
                    {
                        <div style="margin-top: var(--space-3); display: flex; gap: var(--space-2);">
                            <button class="btn btn-secondary" @onclick="() => MakeAdminAsync(membership.UserId, displayName)">
                                @Localizer["SpaceDetail.MakeAdminButton"]
                            </button>
                            <button class="btn btn-danger" @onclick="() => RemoveMemberAsync(membership.UserId, displayName)">
                                @Localizer["SpaceDetail.RemoveButton"]
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        <div style="display: flex; gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-8);">
            <a class="btn btn-secondary" href="@($"/spaces/{SpaceId}/shopping-list")">@Localizer["SpaceDetail.ShoppingListButton"]</a>
            <a class="btn btn-secondary" href="@($"/spaces/{SpaceId}/expenses")">@Localizer["SpaceDetail.ExpensesButton"]</a>
            <a class="btn btn-secondary" href="@($"/spaces/{SpaceId}/reminders")">@Localizer["SpaceDetail.RemindersButton"]</a>
            <a class="btn btn-secondary" href="@($"/spaces/{SpaceId}/notes")">@Localizer["SpaceDetail.NotesButton"]</a>
            @if (isOwner)
            {
                <a class="btn btn-primary" href="@($"/spaces/{SpaceId}/invite")">@Localizer["SpaceDetail.InviteButton"]</a>
            }
            @if (!space.IsPersonal)
            {
                <button class="btn btn-danger" @onclick="LeaveAsync">@Localizer["SpaceDetail.LeaveButton"]</button>
            }
        </div>

        @if (formerMembers.Count > 0)
        {
            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <h2>@Localizer["SpaceDetail.FormerMembersHeading"]</h2>
            <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                @foreach (var archived in formerMembers)
                {
                    <div class="card">
                        <strong>@(string.IsNullOrEmpty(archived.DisplayNameSnapshot) ? Localizer["Space.FormerMember"].Value : archived.DisplayNameSnapshot)</strong>
                        <span class="text-soft">@FormerMemberNote(archived)</span>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid SpaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Space? space;
    private IReadOnlyList<(Membership Membership, string DisplayName)> members = [];
    private IReadOnlyList<MembershipArchive> formerMembers = [];
    private Guid currentUserId;
    private bool isOwner;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        currentUserId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        space = await SpaceService.GetByIdAsync(SpaceId, currentUserId, CancellationToken.None);
        if (space is null)
        {
            NavigationManager.NavigateTo("/spaces");
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        members = await SpaceService.GetMembersAsync(SpaceId, currentUserId, CancellationToken.None);
        formerMembers = await SpaceService.GetFormerMembersAsync(SpaceId, currentUserId, CancellationToken.None);
        isOwner = await SpaceService.IsOwnerAsync(SpaceId, currentUserId, CancellationToken.None);
    }

    private async Task MakeAdminAsync(Guid targetUserId, string targetDisplayName)
    {
        errorMessage = null;
        if (!await JsRuntime.InvokeAsync<bool>("confirm", Localizer["SpaceDetail.MakeAdminConfirm", targetDisplayName].Value))
        {
            return;
        }

        try
        {
            await SpaceService.TransferOwnershipAsync(SpaceId, currentUserId, targetUserId, CancellationToken.None);
            await ReloadAsync();
        }
        catch (Exception)
        {
            errorMessage = Localizer["SpaceDetail.GenericError"];
        }
    }

    private async Task RemoveMemberAsync(Guid targetUserId, string targetDisplayName)
    {
        errorMessage = null;
        if (!await JsRuntime.InvokeAsync<bool>("confirm", Localizer["SpaceDetail.RemoveConfirm", targetDisplayName].Value))
        {
            return;
        }

        try
        {
            await SpaceService.RemoveMemberAsync(SpaceId, currentUserId, targetUserId, CancellationToken.None);
            await ReloadAsync();
        }
        catch (Exception)
        {
            errorMessage = Localizer["SpaceDetail.GenericError"];
        }
    }

    private async Task LeaveAsync()
    {
        errorMessage = null;
        if (!await JsRuntime.InvokeAsync<bool>("confirm", Localizer["SpaceDetail.LeaveConfirm"].Value))
        {
            return;
        }

        try
        {
            await SpaceService.LeaveAsync(SpaceId, currentUserId, CancellationToken.None);
            NavigationManager.NavigateTo("/spaces");
        }
        catch (InvalidOperationException)
        {
            errorMessage = Localizer["SpaceDetail.LeaveTransferFirstError"];
        }
        catch (Exception)
        {
            errorMessage = Localizer["SpaceDetail.GenericError"];
        }
    }

    private string FormerMemberNote(MembershipArchive archived)
    {
        var when = archived.LeftAt.ToString("d", System.Globalization.CultureInfo.CurrentUICulture);
        return archived.Reason switch
        {
            MembershipEndReason.Removed => Localizer["SpaceDetail.FormerMemberRemoved", when],
            MembershipEndReason.AccountDeleted => Localizer["SpaceDetail.FormerMemberAccountDeleted", when],
            _ => Localizer["SpaceDetail.FormerMemberLeft", when],
        };
    }

    private string BadgeClass(AccessLevel level) => level switch
    {
        AccessLevel.None => "badge-none",
        AccessLevel.Availability => "badge-availability",
        AccessLevel.Read => "badge-read",
        AccessLevel.Write => "badge-write",
        AccessLevel.Admin => "badge-admin",
        _ => "badge-none",
    };

    private string LevelName(AccessLevel level) => level switch
    {
        AccessLevel.None => Localizer["AccessLevel.None"],
        AccessLevel.Availability => Localizer["AccessLevel.Availability"],
        AccessLevel.Read => Localizer["AccessLevel.Read"],
        AccessLevel.Write => Localizer["AccessLevel.Write"],
        AccessLevel.Admin => Localizer["AccessLevel.Admin"],
        _ => Localizer["AccessLevel.None"],
    };

    private string ResourceName(ResourceKind resource) => resource switch
    {
        ResourceKind.ShoppingList => Localizer["ResourceKind.ShoppingList"],
        ResourceKind.Expenses => Localizer["ResourceKind.Expenses"],
        ResourceKind.Reminders => Localizer["ResourceKind.Reminders"],
        ResourceKind.Calendar => Localizer["ResourceKind.Calendar"],
        ResourceKind.Notes => Localizer["ResourceKind.Notes"],
        _ => resource.ToString(),
    };
}
