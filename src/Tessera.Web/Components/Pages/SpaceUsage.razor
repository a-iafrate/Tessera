@page "/spaces/{SpaceId:guid}/usage"
@attribute [Authorize]

@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Tessera.Core.Abstractions
@using Tessera.Core.Resources
@using Tessera.Core.Spaces
@using Tessera.Data
@using Tessera.Web.Services

@inject SpaceService SpaceService
@inject UsageService UsageService
@inject IServiceProvider ServiceProvider
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["SpaceUsage.PageTitle"]</PageTitle>

<div class="container">
    @if (space is null)
    {
        <p class="text-soft"><span class="spinner" aria-hidden="true"></span> @Localizer["Common.Loading"]</p>
    }
    else
    {
        <a href="@($"/spaces/{SpaceId}")" class="text-soft">@Localizer["Common.BackToDashboard"]</a>
        <h1>@Localizer["SpaceUsage.PageTitle"] — @space.Name</h1>

        @if (payPalStatusMessage is not null)
        {
            <div class="alert alert-info">@payPalStatusMessage</div>
        }

        <div class="card" style="max-width: 32rem;">
            <h2>@plan!.Name</h2>
            <p class="text-soft">
                @if (plan.MonthlyPrice == 0)
                {
                    @Localizer["SpaceUsage.PriceFree"]
                }
                else
                {
                    @Localizer["SpaceUsage.PriceLine", MoneyFormatter.Format(plan.MonthlyPrice, plan.Currency, CultureInfo.CurrentUICulture.Name)]
                }
            </p>

            @if (currentSubscription is not null)
            {
                <p class="text-soft" style="font-size: var(--text-sm);">@Localizer["SpaceUsage.SubscriptionStatus", SubscriptionStatusLabel(currentSubscription.Status)]</p>
            }

            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <p>@Localizer["SpaceUsage.CallsToday", usedToday, limit]</p>
            <div class="meter" role="progressbar" aria-valuenow="@usedToday" aria-valuemin="0" aria-valuemax="@limit">
                <div class="meter-fill @(usedToday >= limit ? "meter-fill-danger" : "")" style="width: @PercentUsed()%;"></div>
            </div>
            @if (usedToday >= limit)
            {
                <div class="alert alert-danger">@Localizer["SpaceUsage.LimitReachedNote"]</div>
            }
        </div>

        <a class="btn btn-secondary" href="/pricing">@Localizer["SpaceUsage.SeePlansButton"]</a>

        @if (isOwner && payPalSubscriptions is not null && otherPlans.Count > 0)
        {
            <div class="seam" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <h2>@Localizer["SpaceUsage.UpgradeHeading"]</h2>
            @if (subscribeError is not null)
            {
                <div class="alert alert-danger">@subscribeError</div>
            }
            <div style="display: flex; gap: var(--space-4); flex-wrap: wrap; margin-top: var(--space-4);">
                @foreach (var other in otherPlans)
                {
                    <div class="card" style="flex: 1; min-width: 14rem;">
                        <h3 style="margin-bottom: var(--space-2);">@other.Name</h3>
                        <p class="text-soft">@MoneyFormatter.Format(other.MonthlyPrice, other.Currency, CultureInfo.CurrentUICulture.Name) @Localizer["Pricing.PerMonth"]</p>
                        <button type="button" class="btn btn-primary" disabled="@isSubscribing" @onclick="() => SubscribeAsync(other.Id)">
                            @Localizer["SpaceUsage.SubscribeButton"]
                        </button>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid SpaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "paypal")]
    private string? PayPalReturnStatus { get; set; }

    private Space? space;
    private SubscriptionPlan? plan;
    private int usedToday;
    private int limit;
    private bool isOwner;
    private IReadOnlyList<SubscriptionPlan> otherPlans = [];
    private SpaceSubscription? currentSubscription;
    private PayPalSubscriptionService? payPalSubscriptions;
    private bool isSubscribing;
    private string? subscribeError;
    private string? payPalStatusMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        var userId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        var loadedSpace = await SpaceService.GetByIdAsync(SpaceId, userId, CancellationToken.None);
        if (loadedSpace is null)
        {
            NavigationManager.NavigateTo("/spaces");
            return;
        }

        (usedToday, limit, plan) = await UsageService.GetTodayUsageAsync(SpaceId, CancellationToken.None);
        space = loadedSpace;
        isOwner = await SpaceService.IsOwnerAsync(SpaceId, userId, CancellationToken.None);

        // Only registered when PayPal:ClientId/ClientSecret/WebhookId are configured
        // (Program.cs) — resolved this way, rather than @inject, so the page still works when
        // the feature is off (docs/06-roadmap.md).
        payPalSubscriptions = ServiceProvider.GetService<PayPalSubscriptionService>();
        var paymentProvider = ServiceProvider.GetService<IPaymentProvider>();
        if (payPalSubscriptions is not null && paymentProvider is not null)
        {
            var allPlans = await UsageService.GetAllPlansAsync(CancellationToken.None);
            otherPlans = allPlans
                .Where(x => x.Id != plan.Id && (paymentProvider.IsLive ? x.PayPalPlanIdLive : x.PayPalPlanIdSandbox) is not null)
                .ToList();
            currentSubscription = await payPalSubscriptions.GetForSpaceAsync(SpaceId, CancellationToken.None);
        }

        payPalStatusMessage = PayPalReturnStatus switch
        {
            "success" => Localizer["SpaceUsage.PayPalApprovedNote"].Value,
            "cancel" => Localizer["SpaceUsage.PayPalCancelledNote"].Value,
            _ => null,
        };
    }

    private async Task SubscribeAsync(Guid planId)
    {
        if (isSubscribing || payPalSubscriptions is null)
        {
            return;
        }

        isSubscribing = true;
        subscribeError = null;
        try
        {
            var baseUri = NavigationManager.BaseUri.TrimEnd('/');
            var returnUrl = $"{baseUri}/spaces/{SpaceId}/usage?paypal=success";
            var cancelUrl = $"{baseUri}/spaces/{SpaceId}/usage?paypal=cancel";
            var locale = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "it" ? "it-IT" : "en-US";

            var approveUrl = await payPalSubscriptions.CreateSubscriptionAsync(SpaceId, planId, returnUrl, cancelUrl, locale, CancellationToken.None);
            NavigationManager.NavigateTo(approveUrl, forceLoad: true);
        }
        catch (Exception)
        {
            subscribeError = Localizer["SpaceUsage.SubscribeError"];
            isSubscribing = false;
        }
    }

    private string SubscriptionStatusLabel(string status) => status switch
    {
        "APPROVAL_PENDING" => Localizer["SpaceUsage.StatusApprovalPending"],
        "ACTIVE" => Localizer["SpaceUsage.StatusActive"],
        "SUSPENDED" => Localizer["SpaceUsage.StatusSuspended"],
        "CANCELLED" => Localizer["SpaceUsage.StatusCancelled"],
        "EXPIRED" => Localizer["SpaceUsage.StatusExpired"],
        _ => status,
    };

    private double PercentUsed() => limit <= 0 ? 100 : Math.Min(100, usedToday * 100.0 / limit);
}
