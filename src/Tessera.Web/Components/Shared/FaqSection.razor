@using Microsoft.Extensions.Localization
@using Tessera.Core.Resources

@inject IStringLocalizer<Messages> Localizer

<h2>@Localizer["Landing.FaqHeading"]</h2>
<div class="faq-body max-w-40">
    <div class="mb-6">
        <h3 class="faq-question">@Localizer["Landing.FaqFreeQuestion"]</h3>
        <p class="text-soft m-0">@Localizer["Landing.FaqFreeAnswer"]</p>
    </div>
    <div class="mb-6">
        <h3 class="faq-question">@Localizer["Landing.FaqInstallQuestion"]</h3>
        <p class="text-soft m-0">@Localizer["Landing.FaqInstallAnswer"]</p>
    </div>
    <div class="mb-6">
        <h3 class="faq-question">@Localizer["Landing.FaqShareQuestion"]</h3>
        <p class="text-soft m-0">@Localizer["Landing.FaqShareAnswer"]</p>
    </div>
    <div class="mb-6">
        <h3 class="faq-question">@Localizer["Landing.FaqSafeQuestion"]</h3>
        <p class="text-soft m-0">@Localizer["Landing.FaqSafeAnswer"] <a href="/privacy">@Localizer["Landing.FaqSafeLink"]</a></p>
    </div>
    <div>
        <h3 class="faq-question">@Localizer["Landing.FaqCancelQuestion"]</h3>
        <p class="text-soft m-0">@Localizer["Landing.FaqCancelAnswer"]</p>
    </div>
</div>
