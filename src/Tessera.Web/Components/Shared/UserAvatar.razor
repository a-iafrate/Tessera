@if (!string.IsNullOrWhiteSpace(PictureUrl) && !imageFailed)
{
    <img class="user-avatar" style="width: @(Size)rem; height: @(Size)rem;" src="@PictureUrl" alt="@DisplayName" @onerror="() => imageFailed = true" />
}
else
{
    <span class="user-avatar user-avatar-fallback" style="width: @(Size)rem; height: @(Size)rem; font-size: @(Size * 0.5)rem;">
        @Initial
    </span>
}

@code {
    [Parameter]
    public string? DisplayName { get; set; }

    [Parameter]
    public string? PictureUrl { get; set; }

    [Parameter]
    public double Size { get; set; } = 2.5;

    // A third-party URL (Google's CDN today) can fail to load for reasons outside our control
    // — an ad blocker, a corporate filter, a since-rotated URL — so a load failure falls back
    // to the initial rather than leaving the browser's broken-image icon on screen.
    private bool imageFailed;
    private string? lastPictureUrl;

    private string Initial => string.IsNullOrWhiteSpace(DisplayName)
        ? "?"
        : DisplayName.Trim()[..1].ToUpperInvariant();

    protected override void OnParametersSet()
    {
        if (PictureUrl != lastPictureUrl)
        {
            lastPictureUrl = PictureUrl;
            imageFailed = false;
        }
    }
}
