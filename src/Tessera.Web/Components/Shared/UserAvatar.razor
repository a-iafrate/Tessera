@if (!string.IsNullOrWhiteSpace(PictureUrl) && !imageFailed)
{
    <img class="user-avatar" style="width: @(SizeRem)rem; height: @(SizeRem)rem;" src="@PictureUrl" alt="@DisplayName" @onerror="() => imageFailed = true" />
}
else
{
    <span class="user-avatar user-avatar-fallback" style="width: @(SizeRem)rem; height: @(SizeRem)rem; font-size: @(FontSizeRem)rem;">
        @Initial
    </span>
}

@code {
    [Parameter]
    public string? DisplayName { get; set; }

    [Parameter]
    public string? PictureUrl { get; set; }

    [Parameter]
    public double Size { get; set; } = 2.5;

    // A third-party URL (Google's CDN today) can fail to load for reasons outside our control
    // — an ad blocker, a corporate filter, a since-rotated URL — so a load failure falls back
    // to the initial rather than leaving the browser's broken-image icon on screen.
    private bool imageFailed;
    private string? lastPictureUrl;

    private string Initial => string.IsNullOrWhiteSpace(DisplayName)
        ? "?"
        : DisplayName.Trim()[..1].ToUpperInvariant();

    // CSS needs a "." decimal separator regardless of the request's culture — interpolating
    // Size directly (@Size) renders with CurrentCulture, which under it-IT gives "1,75rem":
    // invalid CSS, silently dropped, and the box collapses to its content size instead of a
    // square (border-radius: 50% on a non-square box is what drew the eye/leaf shape instead
    // of a circle).
    private string SizeRem => Size.ToString(System.Globalization.CultureInfo.InvariantCulture);
    private string FontSizeRem => (Size * 0.5).ToString(System.Globalization.CultureInfo.InvariantCulture);

    protected override void OnParametersSet()
    {
        if (PictureUrl != lastPictureUrl)
        {
            lastPictureUrl = PictureUrl;
            imageFailed = false;
        }
    }
}
